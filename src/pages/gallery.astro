---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Lightbox from '../components/Lightbox.astro';
import { gallery } from '../data/content';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Trail Gallery — Photos & Videos from the Camino | Higa Power"
  description="Explore moments, landscapes, milestones, and celebrations captured along the Camino de Santiago with Higa Power pilgrims."
>
  <a class="skip-link" href="#main">Skip to content</a>

  <Header />

  <main id="main">
    <PageHero
      kicker="Trail Gallery"
      title="Moments from"
      titleHighlight="the Camino."
      lead="A visual chronicle of early morning departures, mountain passes, quiet reflections, and joyful arrivals in Santiago de Compostela."
      bgImage="/assets/images/camino-gateway.jpg"
    />

    <section class="section-dark">
      <div class="shell">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-7 mb-12 pb-6 border-b border-white/12 reveal">
          <span class="text-white/80 text-sm font-semibold uppercase tracking-wider">Moments captured along the way</span>
          <p class="m-0 text-white/50 text-sm">
            Click any photo, GIF, or video to view in full resolution.
          </p>
        </div>

        <div
          class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 grid-flow-dense auto-rows-[180px] sm:auto-rows-[200px] md:auto-rows-[220px] lg:auto-rows-[240px] gap-2.5 sm:gap-3.5"
          data-gallery
        >
          {gallery.map((photo, index) => (
            <button
              class:list={[
                'relative overflow-hidden p-0 border-0 rounded-2xl bg-[#32133d] cursor-zoom-in group reveal',
                // 5 Featured wide photos (start, video, landmark, sisterhood, final celebration)
                index === 0 || index === 2 || index === 6 || index === 14 || index === 26 ? 'col-span-2' : '',
                // 4 Featured tall portrait photos (Sahagun gateway, GIF, Azzura, Santiago cathedral)
                index === 4 || index === 12 || index === 22 || index === 25 ? 'row-span-2' : '',
              ]}
              type="button"
              data-index={index}
              data-type={photo.type || 'image'}
              data-full={photo.full}
              data-video-src={photo.videoSrc || ''}
              data-alt={photo.alt}
              aria-label={`Open ${photo.type === 'video' ? 'video' : 'photo'}: ${photo.alt}`}
            >
              <img
                src={photo.thumb}
                alt={photo.alt}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 group-hover:opacity-88 transition-all duration-500 ease-out"
              />
              
              {photo.type === 'video' && (
                <div
                  class="absolute top-3 left-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-white text-[11px] font-extrabold tracking-wider uppercase shadow-[0_4px_12px_rgba(0,0,0,0.3)] backdrop-blur-md"
                  style="background: linear-gradient(135deg, #f027c5, #7021b3);"
                  aria-hidden="true"
                >
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                  <span>Video</span>
                </div>
              )}

              {photo.type === 'gif' && (
                <div
                  class="absolute top-3 left-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-white bg-[#18051f]/85 border border-white/20 text-[11px] font-extrabold tracking-wider uppercase shadow-[0_4px_12px_rgba(0,0,0,0.3)] backdrop-blur-md"
                  aria-hidden="true"
                >
                  <span>GIF</span>
                </div>
              )}

              <span
                class="absolute right-3 bottom-3 py-1.5 px-3 rounded-full text-white bg-[#18051f]/75 backdrop-blur-xs opacity-0 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 text-[11px] font-extrabold uppercase tracking-wider"
                aria-hidden="true"
              >
                {photo.type === 'video' ? 'Play Video' : 'View'}
              </span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Gallery CTA -->
    <section class="section">
      <div class="shell">
        <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 lg:gap-12 p-8 sm:p-12 lg:p-16 rounded-[32px] border border-line bg-white shadow-[0_16px_60px_rgba(42,9,63,0.05)] reveal">
          <div class="max-w-[600px]">
            <p class="kicker kicker-pink">Experience it yourself</p>
            <h2 class="mb-4 text-[clamp(32px,4vw,48px)] leading-tight">Your own Camino memory is <span>waiting.</span></h2>
            <p class="text-muted text-[17px] leading-[1.7] m-0">
              Step out of routine and onto the path of self-discovery. We provide full sponsorship and support to make it possible.
            </p>
          </div>
          <div class="shrink-0">
            <a class="button button-primary" href="/journey">
              Apply for sponsorship <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <Lightbox />

  <script>
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
  </script>
</BaseLayout>
