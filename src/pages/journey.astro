---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Journey from '../components/Journey.astro';
import Footer from '../components/Footer.astro';

const faqs = [
  {
    question: 'What is included in the Higa Power sponsorship?',
    answer:
      'We cover all core journey essentials: accommodation (albergues/hotels along the route), meals, pilgrim credentials/passports, logistical coordination, and group mentorship before, during, and after the walk.',
  },
  {
    question: 'Who is eligible to apply for sponsorship?',
    answer:
      'We welcome women who have faced personal challenges, life transitions, or financial hardship and are seeking personal growth, renewal, and community through walking the Camino de Santiago.',
  },
  {
    question: 'Do I need prior long-distance hiking experience?',
    answer:
      'No prior hiking experience is required! We provide guidance and fitness preparation advice before departing. All you need is determination, an open heart, and willingness to walk step-by-step.',
  },
  {
    question: 'How are applicants selected?',
    answer:
      'Our selection committee reviews each short 300-word application essay based on genuine need, readiness for personal transformation, and alignment with our community values. Shortlisted candidates are invited to a warm Zoom conversation.',
  },
  {
    question: 'Can I sponsor a specific woman or donate to the fund?',
    answer:
      'Yes! We gratefully welcome individual and organizational donors who wish to sponsor a pilgrim. Reach out to helendudleybda@gmail.com to learn more about sponsoring a candidate.',
  },
];
---

<BaseLayout
  title="Sponsorship & Journey — Apply Today | Higa Power"
  description="Apply for a Higa Power sponsorship to walk the Camino de Santiago. Learn about the 3-step process, eligibility, and what is included."
>
  <a class="skip-link" href="#main">Skip to content</a>

  <Header />

  <main id="main">
    <PageHero
      kicker="Sponsorship & Journey"
      title="Take your first brave"
      titleHighlight="step forward."
      lead="We remove the financial and logistical barriers between you and the Camino de Santiago. Learn how our sponsorship works and apply today."
      bgImage="/assets/images/journey-camino.jpg"
    />

    <Journey />

    <!-- What We Provide Section -->
    <section class="section">
      <div class="shell">
        <div class="section-title-row reveal">
          <div>
            <p class="kicker">Full support</p>
            <h2>What we provide <span>for you.</span></h2>
          </div>
          <p>You focus on the walk and your inner journey—we take care of everything else.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-7">
          <div class="p-7 sm:p-9 rounded-3xl border border-line bg-white shadow-[0_14px_45px_rgba(42,9,63,0.04)] reveal">
            <div class="text-4xl mb-5">🏡</div>
            <h3 class="font-display font-bold mb-3 text-[22px] tracking-[-0.03em]">Accommodations & Meals</h3>
            <p class="text-muted leading-[1.7] m-0">Reserved stays along the trail and nutritious meals so you can rest comfortably each night.</p>
          </div>

          <div class="p-7 sm:p-9 rounded-3xl border border-line bg-white shadow-[0_14px_45px_rgba(42,9,63,0.04)] reveal">
            <div class="text-4xl mb-5">🎒</div>
            <h3 class="font-display font-bold mb-3 text-[22px] tracking-[-0.03em]">Gear & Logistics</h3>
            <p class="text-muted leading-[1.7] m-0">Packing guidance, luggage transfer support when needed, and official pilgrim passport registration.</p>
          </div>

          <div class="p-7 sm:p-9 rounded-3xl border border-line bg-white shadow-[0_14px_45px_rgba(42,9,63,0.04)] reveal">
            <div class="text-4xl mb-5">👭</div>
            <h3 class="font-display font-bold mb-3 text-[22px] tracking-[-0.03em]">Sisterhood & Mentorship</h3>
            <p class="text-muted leading-[1.7] m-0">Walk alongside supportive women and receive ongoing dialogue and guidance from founder Ellie.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="section-dark">
      <div class="shell">
        <div class="reveal">
          <p class="kicker kicker-pink">Frequently asked questions</p>
          <h2>Everything you need <span>to know.</span></h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-7 mt-12">
          {faqs.map((faq) => (
            <div class="p-7 sm:p-8 rounded-[20px] bg-white/4 border border-white/10 reveal">
              <h3 class="font-display font-bold mb-3.5 text-pink-soft text-xl tracking-[-0.02em]">{faq.question}</h3>
              <p class="text-white/72 text-base leading-[1.7] m-0">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Application Form / Direct CTA Banner -->
    <section class="section" id="apply">
      <div class="shell">
        <div
          class="p-8 sm:p-12 lg:p-16 rounded-[36px] border border-pink/20 shadow-[0_20px_70px_rgba(42,9,63,0.06)] reveal"
          style="background: linear-gradient(135deg, #fdf6ff 0%, #faeaff 100%);"
        >
          <div class="max-w-[720px] mx-auto text-center">
            <p class="kicker kicker-pink justify-center">Ready to apply?</p>
            <h2 class="text-[clamp(34px,4.5vw,56px)] mb-4.5">Begin your application <span>today.</span></h2>
            <p class="text-muted text-lg leading-[1.7] mb-9">
              Send us an email telling us what you’ve overcome and why walking the Camino de Santiago would be meaningful for your life right now.
            </p>
            <div class="flex justify-center flex-wrap gap-4">
              <a
                class="button button-primary"
                href="mailto:helendudleybda@gmail.com?subject=Higa%20Power%20Sponsorship%20Application"
              >
                Send your application email <span aria-hidden="true">→</span>
              </a>
              <a class="button button-outline-dark" href="/stories">
                Read how others did it <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
  </script>
</BaseLayout>
