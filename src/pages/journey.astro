---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Journey from '../components/Journey.astro';
import Footer from '../components/Footer.astro';

const faqs = [
  {
    question: 'What is included in the Higa Power sponsorship?',
    answer:
      'We cover all core journey essentials: accommodation (albergues/hotels along the route), meals, pilgrim credentials/passports, logistical coordination, and group mentorship before, during, and after the walk.',
  },
  {
    question: 'Who is eligible to apply for sponsorship?',
    answer:
      'We welcome women who have faced personal challenges, life transitions, or financial hardship and are seeking personal growth, renewal, and community through walking the Camino de Santiago.',
  },
  {
    question: 'Do I need prior long-distance hiking experience?',
    answer:
      'No prior hiking experience is required! We provide guidance and fitness preparation advice before departing. All you need is determination, an open heart, and willingness to walk step-by-step.',
  },
  {
    question: 'How are applicants selected?',
    answer:
      'Our selection committee reviews each short 300-word application essay based on genuine need, readiness for personal transformation, and alignment with our community values. Shortlisted candidates are invited to a warm Zoom conversation.',
  },
  {
    question: 'Can I sponsor a specific woman or donate to the fund?',
    answer:
      'Yes! We gratefully welcome individual and organizational donors who wish to sponsor a pilgrim. Reach out to helendudleybda@gmail.com to learn more about sponsoring a candidate.',
  },
];
---

<BaseLayout
  title="Sponsorship & Journey — Apply Today | Higa Power"
  description="Apply for a Higa Power sponsorship to walk the Camino de Santiago. Learn about the 3-step process, eligibility, and what is included."
>
  <a class="skip-link" href="#main">Skip to content</a>

  <Header />

  <main id="main">
    <PageHero
      kicker="Sponsorship & Journey"
      title="Take your first brave"
      titleHighlight="step forward."
      lead="We remove the financial and logistical barriers between you and the Camino de Santiago. Learn how our sponsorship works and apply today."
      bgImage="/assets/images/journey-camino.jpg"
    />

    <Journey />

    <!-- What We Provide Section -->
    <section class="what-we-provide section">
      <div class="shell">
        <div class="section-title-row reveal">
          <div>
            <p class="kicker">Full support</p>
            <h2>What we provide <span>for you.</span></h2>
          </div>
          <p>You focus on the walk and your inner journey—we take care of everything else.</p>
        </div>

        <div class="perks-grid">
          <div class="perk-card reveal">
            <div class="perk-icon">🏡</div>
            <h3>Accommodations & Meals</h3>
            <p>Reserved stays along the trail and nutritious meals so you can rest comfortably each night.</p>
          </div>

          <div class="perk-card reveal">
            <div class="perk-icon">🎒</div>
            <h3>Gear & Logistics</h3>
            <p>Packing guidance, luggage transfer support when needed, and official pilgrim passport registration.</p>
          </div>

          <div class="perk-card reveal">
            <div class="perk-icon">👭</div>
            <h3>Sisterhood & Mentorship</h3>
            <p>Walk alongside supportive women and receive ongoing dialogue and guidance from founder Ellie.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section section-dark">
      <div class="shell">
        <div class="section-heading reveal">
          <p class="kicker kicker-pink">Frequently asked questions</p>
          <h2>Everything you need <span>to know.</span></h2>
        </div>

        <div class="faq-grid">
          {faqs.map((faq) => (
            <div class="faq-card reveal">
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Application Form / Direct CTA Banner -->
    <section class="apply-banner section" id="apply">
      <div class="shell">
        <div class="apply-card reveal">
          <div class="apply-content">
            <p class="kicker kicker-pink">Ready to apply?</p>
            <h2>Begin your application <span>today.</span></h2>
            <p>
              Send us an email telling us what you’ve overcome and why walking the Camino de Santiago would be meaningful for your life right now.
            </p>
            <div class="apply-actions">
              <a
                class="button button-primary"
                href="mailto:helendudleybda@gmail.com?subject=Higa%20Power%20Sponsorship%20Application"
              >
                Send your application email <span aria-hidden="true">→</span>
              </a>
              <a class="button button-outline-dark" href="/stories">
                Read how others did it <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
  </script>
</BaseLayout>

<style>
  /* Perks */
  .perks-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .perk-card {
    padding: 36px 30px;
    border-radius: 24px;
    border: 1px solid var(--color-line);
    background: white;
    box-shadow: 0 14px 45px rgba(42, 9, 63, 0.04);
  }

  .perk-icon {
    font-size: 36px;
    margin-bottom: 20px;
  }

  .perk-card h3 {
    margin-bottom: 12px;
    font-size: 22px;
    letter-spacing: -0.03em;
  }

  .perk-card p {
    color: var(--color-muted);
    line-height: 1.7;
    margin: 0;
  }

  /* FAQ */
  .faq-section {
    background: var(--color-purple-black);
    color: white;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    margin-top: 48px;
  }

  .faq-card {
    padding: 32px 28px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .faq-card h3 {
    margin-bottom: 14px;
    color: var(--color-pink-soft);
    font-size: 20px;
    letter-spacing: -0.02em;
  }

  .faq-card p {
    color: rgba(255, 255, 255, 0.72);
    font-size: 16px;
    line-height: 1.7;
    margin: 0;
  }

  /* Apply Card */
  .apply-card {
    padding: clamp(40px, 6vw, 70px);
    border-radius: 36px;
    background: linear-gradient(135deg, #fdf6ff 0%, #faeaff 100%);
    border: 1px solid rgba(240, 39, 197, 0.2);
    box-shadow: 0 20px 70px rgba(42, 9, 63, 0.06);
  }

  .apply-content {
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
  }

  .apply-content .kicker {
    justify-content: center;
  }

  .apply-content h2 {
    font-size: clamp(34px, 4.5vw, 56px);
    margin-bottom: 18px;
  }

  .apply-content p:not(.kicker) {
    color: var(--color-muted);
    font-size: 18px;
    line-height: 1.7;
    margin-bottom: 36px;
  }

  .apply-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  @media (max-width: 960px) {
    .perks-grid {
      grid-template-columns: 1fr;
    }

    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
