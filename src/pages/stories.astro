---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import StoryCard from '../components/StoryCard.astro';
import { testimonials } from '../data/content';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Pilgrim Stories — Voices of Transformation | Higa Power"
  description="Read inspiring testimonials and firsthand stories from women sponsored by Higa Power on the Camino de Santiago."
>
  <a class="skip-link" href="#main">Skip to content</a>

  <Header />

  <main id="main">
    <PageHero
      kicker="Pilgrim Stories"
      title="Voices of strength and"
      titleHighlight="transformation."
      lead="Every woman who walks with Higa Power brings her own history, challenges, and dreams. Here are their reflections in their own words."
      bgImage="/assets/images/gallery01/we-made-it-to-santiago.jpg"
    />

    <section class="section">
      <div class="shell">
        <div class="max-w-[720px] mb-14 reveal">
          <p class="kicker">In their own words</p>
          <h2 class="mb-4">Real women. <span>Real journeys.</span></h2>
          <p class="lead text-muted">
            The Camino de Santiago is not just a walk—it is a crucible for self-belief, courage, and lifelong bonds.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-7">
          {testimonials.map((story) => (
            <StoryCard story={story} />
          ))}
        </div>
      </div>
    </section>

    <!-- Featured Quote Banner -->
    <section
      class="section-dark text-center"
      style="background: linear-gradient(135deg, #18051f 0%, #320d48 50%, #18051f 100%);"
    >
      <div class="shell max-w-[820px] mx-auto relative reveal">
        <span class="block font-display text-[90px] leading-[0.5] text-pink opacity-80 mb-5" aria-hidden="true">“</span>
        <blockquote class="font-display text-[clamp(26px,3.4vw,40px)] leading-[1.35] text-white m-0 mb-8 italic">
          The Camino is more than just walking—it’s about overcoming life’s obstacles. I am unstoppable. I can do anything!
        </blockquote>
        <div>
          <strong class="block font-display text-xl text-pink-soft font-bold">Samantha</strong>
          <span class="text-xs text-white/60 uppercase tracking-widest">Higa Power Pilgrim · Camino Francés</span>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="section">
      <div class="shell">
        <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 lg:gap-12 p-8 sm:p-12 lg:p-16 rounded-[32px] border border-line bg-white shadow-[0_16px_60px_rgba(42,9,63,0.05)] reveal">
          <div class="max-w-[600px]">
            <p class="kicker kicker-pink">Write your chapter</p>
            <h2 class="mb-4 text-[clamp(32px,4vw,48px)] leading-tight">Are you ready to walk <span>your path?</span></h2>
            <p class="text-muted text-[17px] leading-[1.7] m-0">
              We believe that financial constraints shouldn't keep any deserving woman from experiencing the magic of the Camino. Applications for upcoming sponsorships are open.
            </p>
          </div>
          <div class="flex flex-row flex-wrap lg:flex-col gap-4 shrink-0 w-full lg:w-auto">
            <a class="button button-primary" href="/journey">
              Apply for sponsorship <span aria-hidden="true">→</span>
            </a>
            <a class="button button-outline-dark" href="/gallery">
              Explore the gallery <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
  </script>
</BaseLayout>
