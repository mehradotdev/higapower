---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import StoryCard from '../components/StoryCard.astro';
import { testimonials } from '../data/content';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Pilgrim Stories — Voices of Transformation | Higa Power"
  description="Read inspiring testimonials and firsthand stories from women sponsored by Higa Power on the Camino de Santiago."
>
  <a class="skip-link" href="#main">Skip to content</a>

  <Header />

  <main id="main">
    <PageHero
      kicker="Pilgrim Stories"
      title="Voices of strength and"
      titleHighlight="transformation."
      lead="Every woman who walks with Higa Power brings her own history, challenges, and dreams. Here are their reflections in their own words."
      bgImage="/assets/images/gallery01/we-made-it-to-santiago.jpg"
    />

    <section class="stories-showcase section">
      <div class="shell">
        <div class="stories-intro reveal">
          <p class="kicker">In their own words</p>
          <h2>Real women. <span>Real journeys.</span></h2>
          <p class="lead">
            The Camino de Santiago is not just a walk—it is a crucible for self-belief, courage, and lifelong bonds.
          </p>
        </div>

        <div class="stories-grid">
          {testimonials.map((story) => (
            <StoryCard story={story} />
          ))}
        </div>
      </div>
    </section>

    <!-- Featured Quote Banner -->
    <section class="quote-banner section-dark">
      <div class="shell quote-shell reveal">
        <span class="quote-mark" aria-hidden="true">“</span>
        <blockquote>
          The Camino is more than just walking—it’s about overcoming life’s obstacles. I am unstoppable. I can do anything!
        </blockquote>
        <div class="quote-author">
          <strong>Samantha</strong>
          <span>Higa Power Pilgrim · Camino Francés</span>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="story-cta section">
      <div class="shell story-cta-card reveal">
        <div>
          <p class="kicker kicker-pink">Write your chapter</p>
          <h2>Are you ready to walk <span>your path?</span></h2>
          <p>
            We believe that financial constraints shouldn't keep any deserving woman from experiencing the magic of the Camino. Applications for upcoming sponsorships are open.
          </p>
        </div>
        <div class="story-cta-actions">
          <a class="button button-primary" href="/journey">
            Apply for sponsorship <span aria-hidden="true">→</span>
          </a>
          <a class="button button-outline-dark" href="/gallery">
            Explore the gallery <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
  </script>
</BaseLayout>

<style>
  .stories-intro {
    max-width: 720px;
    margin-bottom: 56px;
  }

  .stories-intro h2 {
    margin-bottom: 16px;
  }

  .stories-intro .lead {
    color: var(--color-muted);
  }

  .stories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 28px;
  }

  /* Quote banner */
  .quote-banner {
    text-align: center;
    background: linear-gradient(135deg, #18051f 0%, #320d48 50%, #18051f 100%);
  }

  .quote-shell {
    max-width: 820px;
    margin-inline: auto;
    position: relative;
  }

  .quote-mark {
    display: block;
    font-family: var(--font-display);
    font-size: 90px;
    line-height: 0.5;
    color: var(--color-pink);
    opacity: 0.8;
    margin-bottom: 20px;
  }

  .quote-banner blockquote {
    font-family: var(--font-display);
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1.35;
    color: white;
    margin: 0 0 32px;
    font-style: italic;
  }

  .quote-author strong {
    display: block;
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--color-pink-soft);
  }

  .quote-author span {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* Story CTA */
  .story-cta-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    padding: clamp(40px, 6vw, 64px);
    border-radius: 32px;
    border: 1px solid var(--color-line);
    background: white;
    box-shadow: 0 16px 60px rgba(42, 9, 63, 0.05);
  }

  .story-cta-card > div:first-child {
    max-width: 600px;
  }

  .story-cta-card h2 {
    margin-bottom: 16px;
    font-size: clamp(32px, 4vw, 48px);
  }

  .story-cta-card p:not(.kicker) {
    color: var(--color-muted);
    font-size: 17px;
    line-height: 1.7;
    margin: 0;
  }

  .story-cta-actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex-shrink: 0;
  }

  @media (max-width: 960px) {
    .story-cta-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
    }

    .story-cta-actions {
      flex-direction: row;
      flex-wrap: wrap;
      width: 100%;
    }
  }

  @media (max-width: 760px) {
    .stories-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
