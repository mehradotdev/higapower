---
import BaseLayout from '../layouts/BaseLayout.astro';
import { testimonials, gallery } from '../data/content';
---

<BaseLayout title="Higa Power — A Camino Collective for Women" description="Higa Power sponsors deserving women to walk the Camino de Santiago and step into courage, connection, and transformation.">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header" data-header>
    <a class="brand" href="#home" aria-label="Higa Power home"><img src="/assets/images/image01.jpg" alt="" width="180" height="180" /><span>Higa Power</span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu-toggle><span class="sr-only">Open menu</span><span></span><span></span></button>
    <nav id="primary-nav" aria-label="Primary navigation" data-nav>
      <a href="#about">About</a><a href="#stories">Stories</a><a href="#events">Events</a><a href="#journey">Join us</a><a href="#gallery">Gallery</a><a class="nav-cta" href="#support">Support us</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero" id="home">
      <div class="hero-photo" role="img" aria-label="Women setting out on the Camino de Santiago"></div><div class="hero-shade"></div>
      <div class="hero-content shell">
        <p class="eyebrow">A Camino collective for women</p>
        <h1>Every journey begins with one <em>brave step.</em></h1>
        <p class="hero-copy">We sponsor deserving women to walk the Camino de Santiago—creating space for courage, connection, and life-changing transformation.</p>
        <div class="hero-actions"><a class="button button-primary" href="#journey">Begin your journey <span aria-hidden="true">→</span></a><a class="button button-quiet" href="#about">Discover Higa Power</a></div>
      </div>
      <div class="hero-note" aria-hidden="true"><strong>Camino de Santiago</strong><span>Spain · Sisterhood · Transformation</span></div>
      <a class="scroll-cue" href="#about" aria-label="Scroll to learn more"><span></span></a>
    </section>

    <section class="intro section" id="about">
      <div class="shell intro-grid">
        <div class="section-heading reveal"><p class="kicker">Our purpose</p><h2>A historic path.<br /><span>A new beginning.</span></h2></div>
        <div class="intro-copy reveal">
          <p class="lead">At Higa Power, we believe in the life-changing impact of the Camino de Santiago.</p>
          <p>We sponsor deserving women to embark on this historic pilgrimage, providing the resources and support they need to succeed. Our mission is to create the opportunity for self-discovery, growth and personal transformation.</p>
          <p>It’s a supportive community where women find the courage to break free from limitations and embrace their authentic voice.</p>
          <a class="text-link" href="#journey">How sponsorship works <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="experience section-dark">
      <div class="shell experience-grid">
        <figure class="experience-image reveal"><img src="/assets/images/image09.jpg" alt="Women celebrating in front of Santiago Cathedral" width="2316" height="1308" loading="lazy" /><figcaption>Arriving in Santiago</figcaption></figure>
        <div class="experience-copy reveal">
          <p class="kicker kicker-pink">The Higa Power experience</p><h2>Walking inward,<br />together.</h2>
          <p>Our female-led, long-distance walks foster an inward journey. The Camino encourages women to tap into their inner strength, feel more confident and rediscover what they are capable of.</p>
          <p>Our coaching doesn’t end when the Camino finishes. We continue the dialogue so each woman can carry the journey’s positive change back into everyday life.</p>
          <div class="experience-stat"><strong>800+</strong><span>kilometres of possibility on the Camino Francés</span></div>
        </div>
      </div>
    </section>

    <section class="stories section" id="stories">
      <div class="shell">
        <div class="section-title-row reveal"><div><p class="kicker">In their own words</p><h2>Stories from<br /><span>the Camino.</span></h2></div><p>Every journey is different. Every courageous step deserves to be heard.</p></div>
        <div class="story-track" aria-label="Testimonials">
          {testimonials.map((story) => <article class="story-card reveal"><div class="story-person"><img src={story.image} alt="" width="240" height="240" loading="lazy" /><div><strong>{story.name}</strong><span>Higa Power pilgrim</span></div></div><blockquote>“{story.quote}”</blockquote><a href={story.link} target="_blank" rel="noreferrer">Read her story <span aria-hidden="true">↗</span></a></article>)}
        </div>
      </div>
    </section>

    <section class="impact" id="support">
      <div class="impact-photo" role="img" aria-label="Two pilgrims walking across the countryside"></div><div class="impact-shade"></div>
      <div class="shell impact-content reveal"><p class="kicker kicker-pink">Make a difference</p><h2>Help another woman<br />take her <span>first step.</span></h2><p>Higa Power depends on private donations and community fundraising to make these transformative journeys accessible to women who need them most.</p><a class="button button-primary" href="#events">Support the next journey <span aria-hidden="true">→</span></a></div>
    </section>

    <section class="events section" id="events">
      <div class="shell">
        <div class="section-title-row reveal"><div><p class="kicker">Miles already walked</p><h2>Challenges with<br /><span>real impact.</span></h2></div><p>Community, courage and a shared destination turn every challenge into meaningful support.</p></div>
        <div class="event-grid">
          <article class="event-card event-main reveal"><img src="/assets/images/image13.jpg" alt="Three Peaks Challenge" width="720" height="405" loading="lazy" /><div class="event-body"><div class="event-meta"><span>September 2024</span><span>United Kingdom</span><span class="status">Completed</span></div><h3>Three Peaks Challenge UK</h3><p>A fundraising climb across Scotland, England and Wales in support of future Higa Power pilgrims.</p><a class="text-link" href="https://www.gofundme.com/f/higa-power-three-peaks-challenge-uk/" target="_blank" rel="noreferrer">Visit the fundraiser <span aria-hidden="true">↗</span></a></div></article>
          <article class="event-card reveal"><img src="/assets/images/image04.jpg" alt="Camino de Santiago Francés" width="2560" height="1445" loading="lazy" /><div class="event-body"><div class="event-meta"><span>April 2024</span><span>Spain</span><span class="status">Completed</span></div><h3>Camino de Santiago Francés</h3><p>Our sponsored pilgrimage across northern Spain—step by step, together.</p></div></article>
        </div>
      </div>
    </section>

    <section class="journey section-dark" id="journey">
      <div class="shell journey-grid">
        <div class="journey-image reveal"><img src="/assets/images/image03.jpg" alt="Pilgrims walking beneath a blue sky" width="1076" height="1077" loading="lazy" /><span class="image-label">Your story belongs on the path</span></div>
        <div class="journey-copy reveal"><p class="kicker kicker-pink">Reach out</p><h2>Start your<br /><span>journey today.</span></h2><p class="lead">Ready to embark on a journey of self-discovery, courage and empowerment?</p>
          <ol class="steps"><li><span>01</span><div><strong>Share your story</strong><p>Tell us what you’ve overcome and what the Camino means to you in a short 300-word essay.</p></div></li><li><span>02</span><div><strong>Committee review</strong><p>We look for genuine need, perseverance and a meaningful connection to the Camino’s purpose.</p></div></li><li><span>03</span><div><strong>Zoom conversation</strong><p>Selected applicants meet our committee to talk about how the journey could be transformative.</p></div></li></ol>
          <a class="button button-primary" href="mailto:helendudleybda@gmail.com?subject=Higa%20Power%20Sponsorship%20Application">Apply for sponsorship <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="founder section">
      <div class="shell founder-grid">
        <div class="founder-copy reveal"><p class="kicker">Meet the founder</p><h2>Ellie, the heart<br />behind <span>Higa Power.</span></h2><p class="lead">“I started Higa Power to help women overcome the financial and personal barriers that stand between them and a transformative Camino.”</p><p>I believe in the power of community, resilience and the magic of the Camino. Let’s make dreams come true together.</p><div class="signature">Ellie <span>Founder, Higa Power</span></div></div>
        <div class="founder-image reveal"><img src="/assets/images/image11.jpg" alt="Ellie, founder of Higa Power" width="1036" height="1036" loading="lazy" /><div class="founder-mark"><img src="/assets/images/image01.jpg" alt="" width="180" height="180" loading="lazy" /></div></div>
      </div>
    </section>

    <section class="higa-story section" id="what-is-higa">
      <div class="shell higa-grid"><img src="/assets/images/image02.jpg" alt="The Higa amulet" width="1154" height="1572" loading="lazy" class="reveal" /><div class="reveal"><p class="kicker">The symbol</p><h2>What is<br /><span>Higa?</span></h2><p>The Higa amulet, also known as the Mano Figa, is a protective charm shaped like a closed fist. For centuries, people have worn it to ward off the evil eye.</p><p>Medieval pilgrims often carried the Higa along the Camino de Santiago for spiritual protection. For women, it also came to represent empowerment and a connection to feminine spiritual strength.</p><p>We chose this amulet to honour its history and its enduring meaning for pilgrims and women focused on cultivating inner strength and perseverance.</p></div></div>
    </section>

    <section class="gallery section-dark" id="gallery">
      <div class="shell">
        <div class="section-title-row reveal"><div><p class="kicker kicker-pink">Along the way</p><h2>Moments from<br /><span>the Camino.</span></h2></div><p>Small moments, hard-won milestones and a community that lasts far beyond the trail.</p></div>
        <div class="gallery-grid" data-gallery>{gallery.map((photo, index) => <button class:list={['gallery-item', { 'gallery-more': index >= 12 }]} type="button" data-full={photo.full} data-alt={photo.alt} aria-label={`Open photo: ${photo.alt}`}><img src={photo.thumb} alt={photo.alt} loading="lazy" /><span aria-hidden="true">View</span></button>)}</div>
        <button class="button button-outline gallery-toggle" type="button" data-gallery-toggle>View the full gallery <span aria-hidden="true">+</span></button>
      </div>
    </section>

    <section class="social section">
      <div class="shell social-grid">
        <div class="social-copy reveal"><p class="kicker">Follow the journey</p><h2>More stories.<br />More <span>brave steps.</span></h2><p>Follow <a href="https://www.instagram.com/higapowers/" target="_blank" rel="noreferrer">@higapowers</a> for trail notes, community stories and more ways to get involved.</p><div class="social-actions"><a class="button button-dark" href="https://www.instagram.com/higapowers/" target="_blank" rel="noreferrer">Instagram <span aria-hidden="true">↗</span></a><a class="button button-outline-dark" href="https://www.facebook.com/profile.php?id=61556930604257" target="_blank" rel="noreferrer">Facebook <span aria-hidden="true">↗</span></a></div></div>
        <div class="social-collage reveal"><a href="https://www.instagram.com/p/C7TqekHstvb/" target="_blank" rel="noreferrer" aria-label="See this Higa Power post on Instagram"><img src="/assets/images/gallery01/7691e640.jpg" alt="Celebrating in Santiago" loading="lazy" /></a><a href="https://www.instagram.com/reel/C7ReuqaNBBS/" target="_blank" rel="noreferrer" aria-label="See this Higa Power reel on Instagram"><img src="/assets/images/gallery01/7a66311a.jpg" alt="Pilgrims enjoying the journey" loading="lazy" /></a><span class="social-badge">@higapowers</span></div>
      </div>
    </section>
  </main>

  <footer><div class="shell footer-main"><div><img src="/assets/images/image01.jpg" alt="Higa Power" width="180" height="180" /><p>Inspiring and supporting women on a transformative journey along the Camino de Santiago.</p></div><div class="footer-links"><div><strong>Explore</strong><a href="#about">About</a><a href="#stories">Stories</a><a href="#events">Events</a><a href="#gallery">Gallery</a></div><div><strong>Connect</strong><a href="https://www.instagram.com/higapowers/" target="_blank" rel="noreferrer">Instagram</a><a href="https://www.facebook.com/profile.php?id=61556930604257" target="_blank" rel="noreferrer">Facebook</a><a href="mailto:helendudleybda@gmail.com">Email</a></div></div><div class="footer-cta"><p>Ready to take the first step?</p><a class="button button-primary" href="mailto:helendudleybda@gmail.com?subject=Higa%20Power%20Sponsorship%20Application">Apply for sponsorship <span aria-hidden="true">→</span></a></div></div><div class="shell footer-bottom"><span>© {new Date().getFullYear()} Higa Power</span><span>Made with 💜 by <a href="https://mehra.dev/" target="_blank" rel="noreferrer">mehra.dev</a></span></div></footer>

  <dialog class="lightbox" data-lightbox><button type="button" class="lightbox-close" aria-label="Close image" data-lightbox-close>×</button><img src="" alt="" data-lightbox-image /><p data-lightbox-caption></p></dialog>

  <script>
    const header = document.querySelector('[data-header]'); const menuButton = document.querySelector('[data-menu-toggle]'); const nav = document.querySelector('[data-nav]');
    const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 30); updateHeader(); window.addEventListener('scroll', updateHeader, { passive: true });
    menuButton?.addEventListener('click', () => { const open = menuButton.getAttribute('aria-expanded') === 'true'; menuButton.setAttribute('aria-expanded', String(!open)); nav?.classList.toggle('is-open', !open); document.body.classList.toggle('menu-open', !open); });
    nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menuButton?.setAttribute('aria-expanded', 'false'); nav.classList.remove('is-open'); document.body.classList.remove('menu-open'); }));
    const revealObserver = new IntersectionObserver((entries) => { entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); revealObserver.unobserve(entry.target); } }); }, { threshold: 0.12 }); document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
    const galleryToggle = document.querySelector('[data-gallery-toggle]'); galleryToggle?.addEventListener('click', () => { const expanded = document.body.classList.toggle('gallery-expanded'); galleryToggle.innerHTML = expanded ? 'Show fewer photos <span aria-hidden="true">−</span>' : 'View the full gallery <span aria-hidden="true">+</span>'; });
    const lightbox = document.querySelector('[data-lightbox]'); const lightboxImage = document.querySelector('[data-lightbox-image]'); const lightboxCaption = document.querySelector('[data-lightbox-caption]');
    document.querySelectorAll('[data-full]').forEach((button) => button.addEventListener('click', () => { if (!(lightbox instanceof HTMLDialogElement) || !(lightboxImage instanceof HTMLImageElement)) return; lightboxImage.src = button.getAttribute('data-full') || ''; lightboxImage.alt = button.getAttribute('data-alt') || ''; if (lightboxCaption) lightboxCaption.textContent = button.getAttribute('data-alt') || ''; lightbox.showModal(); }));
    document.querySelector('[data-lightbox-close]')?.addEventListener('click', () => { if (lightbox instanceof HTMLDialogElement) lightbox.close(); }); lightbox?.addEventListener('click', (event) => { if (event.target === lightbox && lightbox instanceof HTMLDialogElement) lightbox.close(); });
  </script>
</BaseLayout>
