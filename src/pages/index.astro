---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import AboutPreview from '../components/AboutPreview.astro';
import Stories from '../components/Stories.astro';
import JourneyTeaser from '../components/JourneyTeaser.astro';
import Events from '../components/Events.astro';
import GalleryPreview from '../components/GalleryPreview.astro';
import Social from '../components/Social.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
---

<BaseLayout
  title="Higa Power — A Camino Collective for Women"
  description="Higa Power sponsors deserving women to walk the Camino de Santiago and step into courage, connection, and transformation."
>
  <a class="skip-link" href="#main">Skip to content</a>

  <Header />

  <main id="main">
    <Hero />
    <AboutPreview />
    <Stories />
    <JourneyTeaser />
    <Events />
    <GalleryPreview />
    <Social />
  </main>

  <Footer />
  <Lightbox />

  <script>
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
  </script>
</BaseLayout>
