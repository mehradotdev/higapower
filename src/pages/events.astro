---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Events from '../components/Events.astro';
import Impact from '../components/Impact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Events & Challenges — Walking for Impact | Higa Power"
  description="Discover Higa Power fundraising events and challenges, including the Three Peaks Challenge UK and Camino Francés pilgrimages."
>
  <a class="skip-link" href="#main">Skip to content</a>

  <Header />

  <main id="main">
    <PageHero
      kicker="Events & Challenges"
      title="Miles walked with"
      titleHighlight="purpose and impact."
      lead="Every step our team and supporters take powers future sponsorships, giving deserving women the opportunity to transform their lives on the Camino."
      bgImage="/assets/images/three-peaks-challenge.jpg"
    />

    <Events />

    <Impact />

    <!-- How you can get involved -->
    <section class="get-involved section">
      <div class="shell">
        <div class="section-title-row reveal">
          <div>
            <p class="kicker">Support our mission</p>
            <h2>Ways to get <span>involved.</span></h2>
          </div>
          <p>Whether by making a contribution, organizing a walk, or cheering on our pilgrims, your support matters.</p>
        </div>

        <div class="involvement-grid">
          <div class="involvement-card reveal">
            <div class="card-icon" aria-hidden="true">💫</div>
            <h3>Direct Donation</h3>
            <p>
              Your gift directly covers pilgrim accommodations, travel logistics, gear, and ongoing empowerment coaching for sponsored women.
            </p>
            <a class="text-link" href="mailto:helendudleybda@gmail.com?subject=Higa%20Power%20Donation%20Inquiry">
              Inquire about donating <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="involvement-card reveal">
            <div class="card-icon" aria-hidden="true">🥾</div>
            <h3>Take on a Challenge</h3>
            <p>
              Join our fundraising walks or dedicate your personal athletic challenge to Higa Power to raise funds and awareness.
            </p>
            <a class="text-link" href="https://www.instagram.com/higapowers/" target="_blank" rel="noreferrer">
              Connect on Instagram <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="involvement-card reveal">
            <div class="card-icon" aria-hidden="true">🤝</div>
            <h3>Corporate & Community Partner</h3>
            <p>
              Partner with Higa Power as a business or organization to co-sponsor a woman’s journey and champion female resilience.
            </p>
            <a class="text-link" href="mailto:helendudleybda@gmail.com?subject=Higa%20Power%20Partnership">
              Partner with us <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
  </script>
</BaseLayout>

<style>
  .involvement-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .involvement-card {
    padding: 36px 30px;
    border-radius: 24px;
    border: 1px solid var(--color-line);
    background: white;
    box-shadow: 0 14px 45px rgba(42, 9, 63, 0.04);
    display: flex;
    flex-direction: column;
  }

  .card-icon {
    font-size: 36px;
    margin-bottom: 20px;
  }

  .involvement-card h3 {
    margin-bottom: 14px;
    font-size: 22px;
    letter-spacing: -0.03em;
  }

  .involvement-card p {
    color: var(--color-muted);
    line-height: 1.7;
    margin-bottom: 24px;
    flex: 1;
  }

  @media (max-width: 960px) {
    .involvement-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
