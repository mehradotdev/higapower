---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Events from '../components/Events.astro';
import Impact from '../components/Impact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Events & Challenges — Walking for Impact | Higa Power"
  description="Discover Higa Power fundraising events and challenges, including the Three Peaks Challenge UK and Camino Francés pilgrimages."
>
  <a class="skip-link" href="#main">Skip to content</a>

  <Header />

  <main id="main">
    <PageHero
      kicker="Events & Challenges"
      title="Miles walked with"
      titleHighlight="purpose and impact."
      lead="Every step our team and supporters take powers future sponsorships, giving deserving women the opportunity to transform their lives on the Camino."
      bgImage="/assets/images/three-peaks-challenge.jpg"
    />

    <Events />

    <Impact />

    <!-- How you can get involved -->
    <section class="section">
      <div class="shell">
        <div class="section-title-row reveal">
          <div>
            <p class="kicker">Support our mission</p>
            <h2>Ways to get <span>involved.</span></h2>
          </div>
          <p>Whether by making a contribution, organizing a walk, or cheering on our pilgrims, your support matters.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-7">
          <div class="p-7 sm:p-9 rounded-3xl border border-line bg-white shadow-[0_14px_45px_rgba(42,9,63,0.04)] flex flex-col reveal">
            <div class="text-4xl mb-5" aria-hidden="true">💫</div>
            <h3 class="font-display font-bold mb-3.5 text-[22px] tracking-[-0.03em]">Direct Donation</h3>
            <p class="text-muted leading-[1.7] mb-6 flex-1">
              Your gift directly covers pilgrim accommodations, travel logistics, gear, and ongoing empowerment coaching for sponsored women.
            </p>
            <a class="text-link inline-flex" href="mailto:helendudleybda@gmail.com?subject=Higa%20Power%20Donation%20Inquiry">
              Inquire about donating <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="p-7 sm:p-9 rounded-3xl border border-line bg-white shadow-[0_14px_45px_rgba(42,9,63,0.04)] flex flex-col reveal">
            <div class="text-4xl mb-5" aria-hidden="true">🥾</div>
            <h3 class="font-display font-bold mb-3.5 text-[22px] tracking-[-0.03em]">Take on a Challenge</h3>
            <p class="text-muted leading-[1.7] mb-6 flex-1">
              Join our fundraising walks or dedicate your personal athletic challenge to Higa Power to raise funds and awareness.
            </p>
            <a class="text-link inline-flex" href="https://www.instagram.com/higapowers/" target="_blank" rel="noreferrer">
              Connect on Instagram <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="p-7 sm:p-9 rounded-3xl border border-line bg-white shadow-[0_14px_45px_rgba(42,9,63,0.04)] flex flex-col reveal">
            <div class="text-4xl mb-5" aria-hidden="true">🤝</div>
            <h3 class="font-display font-bold mb-3.5 text-[22px] tracking-[-0.03em]">Corporate & Community Partner</h3>
            <p class="text-muted leading-[1.7] mb-6 flex-1">
              Partner with Higa Power as a business or organization to co-sponsor a woman’s journey and champion female resilience.
            </p>
            <a class="text-link inline-flex" href="mailto:helendudleybda@gmail.com?subject=Higa%20Power%20Partnership">
              Partner with us <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
  </script>
</BaseLayout>
