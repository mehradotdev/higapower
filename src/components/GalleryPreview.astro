---
import { gallery } from '../data/content';

// Curate 6 top moments for the homepage preview
const previewItems = gallery.slice(0, 6);
---

<section class="section-dark" id="gallery-preview">
  <div class="shell">
    <div class="section-title-row reveal">
      <div>
        <p class="kicker kicker-pink">Along the trail</p>
        <h2>Moments from<br /><span>the Camino.</span></h2>
      </div>
      <p class="text-white/60">Small moments, hard-won milestones and a community that lasts far beyond the trail.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 auto-rows-[220px] sm:auto-rows-[200px] lg:auto-rows-[240px] gap-3.5" data-gallery>
      {previewItems.map((photo, index) => (
        <button
          class:list={[
            'relative overflow-hidden p-0 border-0 rounded-2xl bg-[#32133d] cursor-zoom-in group reveal',
            index === 0 ? 'lg:col-span-2' : '',
          ]}
          type="button"
          data-index={index}
          data-type={photo.type || 'image'}
          data-full={photo.full}
          data-video-src={photo.videoSrc || ''}
          data-alt={photo.alt}
          aria-label={`Open ${photo.type === 'video' ? 'video' : 'photo'}: ${photo.alt}`}
        >
          <img
            src={photo.thumb}
            alt={photo.alt}
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-105 group-hover:opacity-88 transition-all duration-500 ease-out"
          />
          
          {photo.type === 'video' && (
            <div
              class="absolute top-3 left-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-white text-[11px] font-extrabold tracking-wider uppercase shadow-[0_4px_12px_rgba(0,0,0,0.3)] backdrop-blur-md"
              style="background: linear-gradient(135deg, #f027c5, #7021b3);"
              aria-hidden="true"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
              <span>Video</span>
            </div>
          )}

          <span
            class="absolute right-3 bottom-3 py-1.5 px-3 rounded-full text-white bg-[#18051f]/75 backdrop-blur-xs opacity-0 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 text-[11px] font-extrabold uppercase tracking-wider"
            aria-hidden="true"
          >
            {photo.type === 'video' ? 'Play Video' : 'View'}
          </span>
        </button>
      ))}
    </div>

    <div class="mt-10.5 flex justify-center reveal">
      <a class="button button-primary" href="/gallery">
        Explore full gallery ({gallery.length} moments) <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
