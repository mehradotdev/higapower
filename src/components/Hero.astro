---
---

<section
  class="relative min-h-[720px] sm:min-h-[760px] h-[100svh] grid items-center overflow-hidden text-white"
  id="home"
>
  <div
    class="absolute inset-0 bg-cover bg-no-repeat bg-[58%_center] sm:bg-center scale-[1.015] animate-[hero-in_1.4s_ease_both]"
    style="background-image: url('/assets/images/hero-camino.jpg')"
    role="img"
    aria-label="Women setting out on the Camino de Santiago"
  ></div>
  <div
    class="absolute inset-0"
    style="background: linear-gradient(90deg, rgba(29, 5, 43, 0.94) 0%, rgba(66, 13, 88, 0.78) 47%, rgba(38, 10, 64, 0.18) 100%), linear-gradient(0deg, rgba(22, 4, 35, 0.42), transparent 50%);"
  ></div>

  <div class="shell relative z-2 mt-16 sm:mt-18">
    <p class="eyebrow">A Camino collective for women</p>
    <h1 class="max-w-[850px] mb-0 font-display text-[clamp(47px,15vw,68px)] sm:text-[clamp(54px,7.1vw,100px)] leading-[0.98] tracking-[-0.06em]">
      Every journey begins with one <em class="text-pink not-italic">brave step.</em>
    </h1>
    <p class="max-w-[650px] mt-7 sm:mt-8 mb-0 text-white/80 text-[18px] sm:text-[clamp(18px,2vw,22px)] leading-[1.6]">
      We sponsor deserving women to walk the Camino de Santiago—creating space for courage, connection, and life-changing transformation.
    </p>
    <div class="flex flex-wrap gap-4 mt-9.5">
      <a class="button button-primary" href="/journey">
        Begin your journey <span aria-hidden="true">→</span>
      </a>
      <a class="button button-quiet" href="/about">
        Discover Higa Power
      </a>
    </div>
  </div>

  <div
    class="hidden sm:grid absolute z-2 right-[max(24px,calc((100vw-var(--max))/2))] bottom-9 text-right gap-1"
    aria-hidden="true"
  >
    <strong class="text-[13px] uppercase tracking-[0.12em] font-bold">Camino de Santiago</strong>
    <span class="text-[13px] text-white/60">Spain · Sisterhood · Transformation</span>
  </div>

  <a
    class="hidden sm:block absolute z-3 bottom-7.5 left-1/2 -translate-x-1/2 w-8 h-12 border border-white/35 rounded-[20px]"
    href="#about"
    aria-label="Scroll to learn more"
  >
    <span class="absolute top-2.5 left-[calc(50%-2px)] w-1 h-2 rounded-[3px] bg-white animate-[scroll-cue_1.8s_infinite]"></span>
  </a>
</section>

<style>
  @keyframes hero-in {
    from {
      transform: scale(1.08);
      opacity: 0.55;
    }
    to {
      transform: scale(1.015);
      opacity: 1;
    }
  }

  @keyframes scroll-cue {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>
