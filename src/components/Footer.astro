---
const currentYear = new Date().getFullYear();
---

<footer class="pt-20 pb-6 text-white bg-purple-black">
  <div class="shell grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1fr_0.8fr_1fr] gap-12 lg:gap-16 pb-16">
    <div>
      <a href="/" aria-label="Higa Power Home">
        <img
          src="/assets/images/higa-power-logo.jpg"
          alt="Higa Power"
          width="180"
          height="180"
          loading="lazy"
          class="w-20 h-20 rounded-xl object-cover"
        />
      </a>
      <p class="max-w-[310px] mt-5.5 text-white/60 leading-[1.7]">
        Inspiring and supporting women on a transformative journey along the Camino de Santiago.
      </p>
    </div>
    
    <div class="grid grid-cols-2 gap-8">
      <div class="flex flex-col items-start gap-3">
        <strong class="mb-1 text-pink text-xs uppercase tracking-[0.14em]">Explore</strong>
        <a href="/about" class="text-white/70 hover:text-white transition-colors">About Us</a>
        <a href="/stories" class="text-white/70 hover:text-white transition-colors">Stories</a>
        <a href="/events" class="text-white/70 hover:text-white transition-colors">Events</a>
        <a href="/gallery" class="text-white/70 hover:text-white transition-colors">Gallery</a>
        <a href="/journey" class="text-white/70 hover:text-white transition-colors">Sponsorship</a>
      </div>
      <div class="flex flex-col items-start gap-3">
        <strong class="mb-1 text-pink text-xs uppercase tracking-[0.14em]">Connect</strong>
        <a href="https://www.instagram.com/higapowers/" target="_blank" rel="noreferrer" class="text-white/70 hover:text-white transition-colors">Instagram</a>
        <a href="https://www.facebook.com/profile.php?id=61556930604257" target="_blank" rel="noreferrer" class="text-white/70 hover:text-white transition-colors">Facebook</a>
        <a href="mailto:helendudleybda@gmail.com" class="text-white/70 hover:text-white transition-colors">Email</a>
      </div>
    </div>
    
    <div class="flex flex-col items-start gap-4 md:col-span-2 lg:col-span-1">
      <strong class="text-pink text-xs uppercase tracking-[0.14em]">Get Involved</strong>
      <p class="m-0 font-display text-[23px] font-bold leading-tight">Ready to take the first step?</p>
      <a class="button button-primary" href="/journey">
        Apply for sponsorship <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
  
  <div class="shell flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 pt-5.5 border-t border-white/12 text-white/45 text-xs">
    <span>© {currentYear} Higa Power</span>
    <span>Made with 💜 by <a href="https://mehra.dev/" target="_blank" rel="noreferrer" class="text-pink-soft underline">mehra.dev</a></span>
  </div>
</footer>
