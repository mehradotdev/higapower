---
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="shell footer-main">
    <div>
      <a href="/" aria-label="Higa Power Home">
        <img src="/assets/images/higa-power-logo.jpg" alt="Higa Power" width="180" height="180" loading="lazy" />
      </a>
      <p>Inspiring and supporting women on a transformative journey along the Camino de Santiago.</p>
    </div>
    
    <div class="footer-links">
      <div>
        <strong>Explore</strong>
        <a href="/about">About Us</a>
        <a href="/stories">Stories</a>
        <a href="/events">Events</a>
        <a href="/gallery">Gallery</a>
        <a href="/journey">Sponsorship</a>
      </div>
      <div>
        <strong>Connect</strong>
        <a href="https://www.instagram.com/higapowers/" target="_blank" rel="noreferrer">Instagram</a>
        <a href="https://www.facebook.com/profile.php?id=61556930604257" target="_blank" rel="noreferrer">Facebook</a>
        <a href="mailto:helendudleybda@gmail.com">Email</a>
      </div>
    </div>
    
    <div class="footer-cta">
      <strong>Get Involved</strong>
      <p>Ready to take the first step?</p>
      <a class="button button-primary" href="/journey">
        Apply for sponsorship <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
  
  <div class="shell footer-bottom">
    <span>© {currentYear} Higa Power</span>
    <span>Made with 💜 by <a href="https://mehra.dev/" target="_blank" rel="noreferrer">mehra.dev</a></span>
  </div>
</footer>

<style>
  footer {
    padding: 76px 0 22px;
    color: white;
    background: var(--color-purple-black);
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1fr 0.8fr 1fr;
    gap: 70px;
    padding-bottom: 64px;
  }

  .footer-main > div:first-child img {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    object-fit: cover;
  }

  .footer-main > div:first-child p {
    max-width: 310px;
    margin-top: 22px;
    color: rgba(255, 255, 255, 0.57);
    line-height: 1.7;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }

  .footer-links div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 13px;
  }

  .footer-links strong {
    margin-bottom: 7px;
    color: var(--color-pink);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .footer-links a {
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: white;
  }

  .footer-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .footer-cta strong {
    color: var(--color-pink);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .footer-cta p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 23px;
    font-weight: 700;
    line-height: 1.35;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.43);
    font-size: 12px;
  }

  .footer-bottom a {
    color: var(--color-pink-soft);
    text-decoration: underline;
  }

  @media (max-width: 960px) {
    .footer-main {
      grid-template-columns: 1fr 1fr;
    }

    .footer-cta {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 760px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .footer-cta {
      grid-column: auto;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
