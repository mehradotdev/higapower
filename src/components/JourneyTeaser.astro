---
import { journeySteps } from '../data/content';
---

<section class="section-dark" id="sponsorship">
  <div class="shell">
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end gap-5 lg:gap-10 mb-14 reveal">
      <div>
        <p class="kicker kicker-pink">Sponsorship program</p>
        <h2 class="mb-0">Three steps to your <span>Camino.</span></h2>
      </div>
      <p class="max-w-[380px] m-0 text-white/65 text-[17px] leading-[1.7]">
        We remove the financial and logistical barriers so you can focus on self-discovery and transformation.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-12">
      {journeySteps.map((item) => (
        <div class="p-7 sm:p-9 rounded-3xl bg-white/4 border border-white/10 relative overflow-hidden hover:-translate-y-1 hover:bg-white/7 transition-all duration-200 reveal">
          <div class="font-display text-[15px] font-extrabold text-pink mb-5 tracking-widest">{item.step}</div>
          <h3 class="m-0 mb-3 text-[22px] text-white tracking-[-0.02em] font-display font-bold">{item.title}</h3>
          <p class="m-0 text-white/60 text-[15px] leading-[1.7]">{item.description}</p>
        </div>
      ))}
    </div>

    <div class="flex justify-center items-center flex-wrap gap-4 reveal">
      <a class="button button-primary" href="/journey">
        Apply for sponsorship <span aria-hidden="true">→</span>
      </a>
      <a class="button button-quiet" href="/journey">
        Learn what's included & FAQs <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
