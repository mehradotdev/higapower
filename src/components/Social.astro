<section class="section" id="social">
  <div class="shell grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-12 lg:gap-24 items-center">
    <div class="reveal">
      <p class="kicker">Follow the journey</p>
      <h2>More stories.<br />More <span>brave steps.</span></h2>
      <p class="text-muted text-[18px] leading-[1.7]">
        Follow <a class="text-purple font-extrabold hover:text-pink transition-colors" href="https://www.instagram.com/higapowers/" target="_blank" rel="noreferrer">@higapowers</a> for trail notes, community stories and more ways to get involved.
      </p>
      <div class="flex flex-wrap gap-4 mt-9.5">
        <a class="button button-dark" href="https://www.instagram.com/higapowers/" target="_blank" rel="noreferrer">
          Instagram <span aria-hidden="true">↗</span>
        </a>
        <a class="button button-outline-dark" href="https://www.facebook.com/profile.php?id=61556930604257" target="_blank" rel="noreferrer">
          Facebook <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    
    <div class="relative min-h-[460px] sm:min-h-[570px] w-full max-w-[700px] lg:max-w-none reveal">
      <a
        href="https://www.instagram.com/p/C7TqekHstvb/"
        target="_blank"
        rel="noreferrer"
        aria-label="See this Higa Power post on Instagram"
        class="absolute top-0 left-0 w-[56%] overflow-hidden rounded-[20px] shadow-[0_25px_70px_rgba(42,9,63,0.18)] -rotate-4 hover:-rotate-2 hover:scale-[1.02] transition-transform duration-300 ease-out"
      >
        <img
          src="/assets/images/gallery01/we-made-it-to-santiago.jpg"
          alt="Celebrating in Santiago"
          loading="lazy"
          class="w-full aspect-[0.82] object-cover"
        />
      </a>
      <a
        href="https://www.instagram.com/reel/C7ReuqaNBBS/"
        target="_blank"
        rel="noreferrer"
        aria-label="See this Higa Power reel on Instagram"
        class="absolute right-0 bottom-0 w-[56%] overflow-hidden rounded-[20px] shadow-[0_25px_70px_rgba(42,9,63,0.18)] rotate-5 hover:rotate-3 hover:scale-[1.02] transition-transform duration-300 ease-out"
      >
        <img
          src="/assets/images/gallery01/joy-along-the-way.jpg"
          alt="Pilgrims enjoying the journey"
          loading="lazy"
          class="w-full aspect-[0.82] object-cover"
        />
      </a>
      <span
        class="absolute z-3 top-[45%] left-[43%] px-5 py-3.5 rounded-full text-white font-extrabold -rotate-2 shadow-[0_12px_35px_rgba(42,9,63,0.25)] text-sm sm:text-base pointer-events-none"
        style="background: linear-gradient(135deg, #f027c5, #7021b3);"
      >
        @higapowers
      </span>
    </div>
  </div>
</section>
