---
import { journeySteps } from '../data/content';
---

<section class="section-dark" id="journey">
  <div class="shell grid grid-cols-1 lg:grid-cols-[0.92fr_1.08fr] gap-12 lg:gap-24 items-center">
    <div class="relative max-w-[720px] lg:max-w-none reveal">
      <img
        src="/assets/images/journey-camino.jpg"
        alt="Pilgrims walking beneath a blue sky"
        width="1076"
        height="1077"
        loading="lazy"
        class="w-full min-h-[500px] sm:min-h-[560px] lg:min-h-[690px] object-cover rounded-[80px_4px_4px_4px] sm:rounded-[120px_4px_4px_4px]"
      />
      <span class="absolute -right-1.5 sm:-right-5.5 bottom-8.5 max-w-[160px] p-4.5 rounded-2xl text-purple-deep bg-pink-soft font-display text-sm font-extrabold leading-snug -rotate-3 shadow-lg">
        Your story belongs on the path
      </span>
    </div>
    <div class="reveal">
      <p class="kicker kicker-pink">Reach out</p>
      <h2>Start your<br /><span>journey today.</span></h2>
      <p class="lead text-white/75">Ready to embark on a journey of self-discovery, courage and empowerment?</p>
      
      <ol class="my-9 p-0 list-none">
        {journeySteps.map((item) => (
          <li class="grid grid-cols-[45px_1fr] gap-4 py-5 border-t border-white/14">
            <span class="text-pink text-xs font-extrabold tracking-widest">{item.step}</span>
            <div>
              <strong class="font-display text-lg text-white font-bold">{item.title}</strong>
              <p class="mt-1.5 mb-0 text-white/60 leading-relaxed text-sm sm:text-base">{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
      
      <a class="button button-primary" href="mailto:helendudleybda@gmail.com?subject=Higa%20Power%20Sponsorship%20Application">
        Apply for sponsorship <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
