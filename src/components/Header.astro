---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { href: '/about', label: 'About' },
  { href: '/stories', label: 'Stories' },
  { href: '/events', label: 'Events' },
  { href: '/gallery', label: 'Gallery' },
];

const isCurrent = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header
  class="fixed z-20 top-0 left-1/2 -translate-x-1/2 h-[78px] md:h-[92px] flex items-center justify-between w-[min(calc(100%-32px),var(--max))] md:w-[min(calc(100%-48px),var(--max))] text-white border-b border-white/22 transition-all duration-300 [&.is-scrolled]:top-3 [&.is-scrolled]:w-[min(calc(100%-24px),1220px)] md:[&.is-scrolled]:w-[min(calc(100%-32px),1220px)] [&.is-scrolled]:h-16 md:[&.is-scrolled]:h-[70px] [&.is-scrolled]:px-3.5 md:[&.is-scrolled]:px-5 [&.is-scrolled]:border [&.is-scrolled]:border-white/10 [&.is-scrolled]:rounded-full [&.is-scrolled]:bg-[#1c0627]/90 [&.is-scrolled]:backdrop-blur-xl [&.is-scrolled]:shadow-[0_12px_40px_rgba(17,2,24,0.2)]"
  data-header
>
  <a class="flex items-center gap-3 font-display font-extrabold" href="/" aria-label="Higa Power home">
    <img
      src="/assets/images/higa-power-logo.jpg"
      alt="Higa Power logo"
      width="180"
      height="180"
      class="w-[54px] h-[54px] md:w-16 md:h-16 rounded-[9px] object-cover transition-all duration-300 header-scrolled:w-11 header-scrolled:h-11"
    />
    <span class="sr-only">Higa Power</span>
  </a>

  <button
    class="relative z-3 w-11.5 h-11.5 grid md:hidden place-content-center gap-1.5 p-0 border border-white/35 rounded-full bg-white/7 cursor-pointer group"
    type="button"
    aria-expanded="false"
    aria-controls="primary-nav"
    data-menu-toggle
  >
    <span class="sr-only">Open menu</span>
    <span class="w-5 h-0.5 bg-white transition-transform group-aria-expanded:translate-y-[4.5px] group-aria-expanded:rotate-45"></span>
    <span class="w-5 h-0.5 bg-white transition-transform group-aria-expanded:-translate-y-[4.5px] group-aria-expanded:-rotate-45"></span>
  </button>

  <nav
    id="primary-nav"
    aria-label="Primary navigation"
    class="fixed md:static z-2 inset-[-12px_-12px_auto] md:inset-auto h-[100dvh] md:h-auto flex flex-col md:flex-row items-start md:items-center justify-center md:justify-start gap-6 md:gap-7 p-9 pt-24 md:p-0 bg-[#18051f]/98 md:bg-transparent opacity-0 md:opacity-100 invisible md:visible -translate-y-3 md:translate-y-0 transition-all duration-250 font-semibold [&.is-open]:opacity-100 [&.is-open]:visible [&.is-open]:translate-y-0"
    data-nav
  >
    <a
      href="/"
      class:list={[
        'relative font-display text-[28px] md:text-base md:font-sans opacity-85 hover:opacity-100 hover:text-pink-soft focus-visible:opacity-100 focus-visible:text-pink-soft transition-colors',
        { 'opacity-100 text-pink-soft after:content-[""] after:absolute after:-bottom-1 md:after:-bottom-1.5 after:inset-x-0 after:h-0.5 after:bg-pink after:rounded-sm': pathname === '/' },
      ]}
    >
      Home
    </a>
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={[
          'relative font-display text-[28px] md:text-base md:font-sans opacity-85 hover:opacity-100 hover:text-pink-soft focus-visible:opacity-100 focus-visible:text-pink-soft transition-colors',
          { 'opacity-100 text-pink-soft after:content-[""] after:absolute after:-bottom-1 md:after:-bottom-1.5 after:inset-x-0 after:h-0.5 after:bg-pink after:rounded-sm': isCurrent(item.href) },
        ]}
      >
        {item.label}
      </a>
    ))}
    <a
      class="mt-3 md:mt-0 px-5 py-2.5 border border-white/70 rounded-full text-white text-lg md:text-sm hover:text-black hover:bg-white hover:border-white transition-colors font-medium"
      href="/journey"
    >
      Join us
    </a>
  </nav>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const menuButton = document.querySelector('[data-menu-toggle]');
  const nav = document.querySelector('[data-nav]');

  const updateHeader = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 30);
  };
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  menuButton?.addEventListener('click', () => {
    const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!isOpen));
    nav?.classList.toggle('is-open', !isOpen);
    document.body.classList.toggle('menu-open', !isOpen);
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menuButton?.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
      document.body.classList.remove('menu-open');
    });
  });
</script>
