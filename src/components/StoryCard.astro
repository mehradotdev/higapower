---
import type { Testimonial } from '../data/types';

interface Props {
  story: Testimonial;
}

const { story } = Astro.props;
---

<article class="min-h-[410px] sm:min-h-[395px] flex flex-col p-6 sm:p-8 border border-line rounded-3xl bg-paper shadow-[0_14px_50px_rgba(42,9,63,0.04)] snap-start reveal">
  <div class="flex items-center gap-3.5">
    <img
      src={story.image}
      alt={story.name}
      width="240"
      height="240"
      loading="lazy"
      class="w-14 h-14 object-cover rounded-full"
    />
    <div class="grid gap-0.5">
      <strong class="font-display text-ink font-bold">{story.name}</strong>
      <span class="text-muted text-xs">Higa Power pilgrim</span>
    </div>
  </div>
  <blockquote class="flex-1 my-7 font-display text-lg leading-[1.62] text-ink">
    “{story.quote}”
  </blockquote>
  <a
    href={story.link}
    target="_blank"
    rel="noreferrer"
    class="text-purple font-extrabold text-sm inline-flex items-center gap-1.5 hover:text-pink transition-colors"
  >
    Read her story <span aria-hidden="true">↗</span>
  </a>
</article>
