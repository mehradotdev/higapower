---
import { testimonials } from '../data/content';
import StoryCard from './StoryCard.astro';
---

<section class="section section-tight-top" id="stories">
  <div class="shell">
    <div class="section-title-row reveal">
      <div>
        <p class="kicker">In their own words</p>
        <h2>Stories from<br /><span>the Camino.</span></h2>
      </div>
      <div class="flex flex-col items-start lg:items-end gap-4 max-w-[420px] mt-4 lg:mt-0">
        <p class="m-0 text-left lg:text-right text-muted text-[17px] leading-[1.7]">
          Every journey is different. Every courageous step deserves to be heard.
        </p>
        <div class="flex items-center gap-3" aria-label="Testimonial carousel controls">
          <button
            type="button"
            class="w-12 h-12 rounded-full border border-line bg-[#fbf5fd] text-purple inline-flex items-center justify-center cursor-pointer shadow-[0_4px_14px_rgba(42,9,63,0.06)] hover:enabled:bg-purple hover:enabled:text-white hover:enabled:border-purple hover:enabled:scale-108 hover:enabled:shadow-[0_8px_22px_rgba(112,33,179,0.25)] active:enabled:scale-95 disabled:opacity-30 disabled:cursor-not-allowed disabled:bg-[#2a093f]/3 disabled:border-[#2a093f]/8 transition-all duration-200 group"
            data-track-prev
            aria-label="Previous testimonials"
          >
            <svg class="w-5 h-5 transition-transform group-hover:enabled:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6"/>
            </svg>
          </button>
          <button
            type="button"
            class="w-12 h-12 rounded-full border border-line bg-[#fbf5fd] text-purple inline-flex items-center justify-center cursor-pointer shadow-[0_4px_14px_rgba(42,9,63,0.06)] hover:enabled:bg-purple hover:enabled:text-white hover:enabled:border-purple hover:enabled:scale-108 hover:enabled:shadow-[0_8px_22px_rgba(112,33,179,0.25)] active:enabled:scale-95 disabled:opacity-30 disabled:cursor-not-allowed disabled:bg-[#2a093f]/3 disabled:border-[#2a093f]/8 transition-all duration-200 group"
            data-track-next
            aria-label="Next testimonials"
          >
            <svg class="w-5 h-5 transition-transform group-hover:enabled:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div
      class="grid grid-flow-col auto-cols-[88%] sm:auto-cols-[minmax(310px,1fr)] gap-5 overflow-x-auto overflow-y-hidden overscroll-x-contain py-2.5 px-1 pb-6 snap-x snap-mandatory [scrollbar-width:thin] [scrollbar-color:#f027c5_rgba(42,9,63,0.08)]"
      aria-label="Testimonials"
      data-story-track
    >
      {testimonials.map((story) => (
        <StoryCard story={story} />
      ))}
    </div>

    <div class="mt-7 flex justify-start lg:justify-end reveal">
      <a class="text-link inline-flex" href="/stories">
        Read all pilgrim stories <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<script>
  const track = document.querySelector('[data-story-track]');
  const prevBtn = document.querySelector('[data-track-prev]');
  const nextBtn = document.querySelector('[data-track-next]');

  const updateNavButtons = () => {
    if (!track || !prevBtn || !nextBtn) return;
    const isAtStart = track.scrollLeft <= 10;
    const isAtEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 10;
    if (prevBtn instanceof HTMLButtonElement) prevBtn.disabled = isAtStart;
    if (nextBtn instanceof HTMLButtonElement) nextBtn.disabled = isAtEnd;
  };

  const getScrollDistance = () => {
    if (!track) return 340;
    const firstCard = track.querySelector('article');
    return firstCard ? firstCard.clientWidth + 20 : 340;
  };

  prevBtn?.addEventListener('click', () => {
    track?.scrollBy({ left: -getScrollDistance(), behavior: 'smooth' });
  });

  nextBtn?.addEventListener('click', () => {
    track?.scrollBy({ left: getScrollDistance(), behavior: 'smooth' });
  });

  track?.addEventListener('scroll', updateNavButtons, { passive: true });
  window.addEventListener('resize', updateNavButtons, { passive: true });
  updateNavButtons();
</script>
