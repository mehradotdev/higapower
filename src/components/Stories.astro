---
import { testimonials } from '../data/content';
import StoryCard from './StoryCard.astro';
---

<section class="stories section" id="stories">
  <div class="shell">
    <div class="section-title-row reveal">
      <div>
        <p class="kicker">In their own words</p>
        <h2>Stories from<br /><span>the Camino.</span></h2>
      </div>
      <div class="stories-header-actions">
        <p>Every journey is different. Every courageous step deserves to be heard.</p>
        <div class="track-nav" aria-label="Testimonial carousel controls">
          <button
            type="button"
            class="track-nav-btn prev"
            data-track-prev
            aria-label="Previous testimonials"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6"/>
            </svg>
          </button>
          <button
            type="button"
            class="track-nav-btn next"
            data-track-next
            aria-label="Next testimonials"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="story-track" aria-label="Testimonials" data-story-track>
      {testimonials.map((story) => (
        <StoryCard story={story} />
      ))}
    </div>

    <div class="stories-footer reveal">
      <a class="text-link" href="/stories">
        Read all pilgrim stories <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .stories-header-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 16px;
    max-width: 420px;
  }

  .stories-header-actions > p {
    margin: 0;
    text-align: right;
    color: var(--color-muted);
    font-size: 17px;
    line-height: 1.7;
  }

  .track-nav {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .track-nav-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--color-line);
    background: #fbf5fd;
    color: var(--color-purple);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(42, 9, 63, 0.06);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .track-nav-btn svg {
    width: 20px;
    height: 20px;
    transition: transform 0.2s;
  }

  .track-nav-btn:hover:not(:disabled) {
    background: var(--color-purple);
    color: white;
    border-color: var(--color-purple);
    transform: scale(1.08);
    box-shadow: 0 8px 22px rgba(112, 33, 179, 0.25);
  }

  .track-nav-btn:hover:not(:disabled).prev svg {
    transform: translateX(-2px);
  }

  .track-nav-btn:hover:not(:disabled).next svg {
    transform: translateX(2px);
  }

  .track-nav-btn:active:not(:disabled) {
    transform: scale(0.95);
  }

  .track-nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    background: rgba(42, 9, 63, 0.03);
    border-color: rgba(42, 9, 63, 0.08);
  }

  .story-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(310px, 1fr);
    gap: 20px;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    padding: 10px 4px 24px;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--color-pink) rgba(42, 9, 63, 0.08);
  }

  .stories-footer {
    margin-top: 28px;
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 960px) {
    .stories-header-actions {
      align-items: flex-start;
      margin-top: 16px;
    }

    .stories-header-actions > p {
      text-align: left;
    }
  }

  @media (max-width: 760px) {
    .story-track {
      grid-auto-columns: 88%;
    }

    .stories-footer {
      justify-content: flex-start;
    }
  }
</style>

<script>
  const track = document.querySelector('[data-story-track]');
  const prevBtn = document.querySelector('[data-track-prev]');
  const nextBtn = document.querySelector('[data-track-next]');

  const updateNavButtons = () => {
    if (!track || !prevBtn || !nextBtn) return;
    const isAtStart = track.scrollLeft <= 10;
    const isAtEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 10;
    if (prevBtn instanceof HTMLButtonElement) prevBtn.disabled = isAtStart;
    if (nextBtn instanceof HTMLButtonElement) nextBtn.disabled = isAtEnd;
  };

  const getScrollDistance = () => {
    if (!track) return 340;
    const firstCard = track.querySelector('article');
    return firstCard ? firstCard.clientWidth + 20 : 340;
  };

  prevBtn?.addEventListener('click', () => {
    track?.scrollBy({ left: -getScrollDistance(), behavior: 'smooth' });
  });

  nextBtn?.addEventListener('click', () => {
    track?.scrollBy({ left: getScrollDistance(), behavior: 'smooth' });
  });

  track?.addEventListener('scroll', updateNavButtons, { passive: true });
  window.addEventListener('resize', updateNavButtons, { passive: true });
  updateNavButtons();
</script>
