---
interface Props {
  kicker: string;
  title: string;
  titleHighlight?: string;
  lead: string;
  bgImage?: string;
}

const { kicker, title, titleHighlight, lead, bgImage } = Astro.props;
---

<section class="relative pt-28 sm:pt-36 lg:pt-44 pb-12 sm:pb-16 lg:pb-24 overflow-hidden text-white bg-purple-black">
  {bgImage && (
    <div
      class="absolute inset-0 bg-cover bg-center opacity-28 saturate-120"
      style={`background-image: url('${bgImage}')`}
      role="img"
      aria-hidden="true"
    />
  )}
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: linear-gradient(180deg, rgba(24, 5, 31, 0.75) 0%, rgba(24, 5, 31, 0.95) 85%, #18051f 100%), radial-gradient(ellipse at 80% 20%, rgba(240, 39, 197, 0.15), transparent 60%);"
  ></div>
  <div
    class="absolute -top-[30%] -right-[10%] w-[600px] h-[600px] rounded-full blur-[60px] pointer-events-none"
    style="background: radial-gradient(circle, rgba(112, 33, 179, 0.35) 0%, rgba(240, 39, 197, 0.15) 45%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <div class="shell relative z-2">
    <nav class="flex items-center gap-2.5 mb-6 text-[13px] font-semibold text-white/50" aria-label="Breadcrumb">
      <a href="/" class="text-white/70 hover:text-pink-soft transition-colors">Home</a>
      <span aria-hidden="true">/</span>
      <span class="text-pink-soft" aria-current="page">{kicker}</span>
    </nav>

    <div class="reveal">
      <p class="kicker kicker-pink">{kicker}</p>
      <h1 class="max-w-[820px] mb-5.5 font-display text-[clamp(38px,5.2vw,68px)] leading-[1.05] tracking-[-0.05em] text-white">
        {title}
        {titleHighlight && <span class="text-pink"> {titleHighlight}</span>}
      </h1>
      <p class="lead max-w-[640px] mb-0 text-white/75 text-[clamp(17px,1.8vw,21px)] leading-[1.6]">
        {lead}
      </p>
    </div>
  </div>
</section>
