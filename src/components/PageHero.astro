---
interface Props {
  kicker: string;
  title: string;
  titleHighlight?: string;
  lead: string;
  bgImage?: string;
}

const { kicker, title, titleHighlight, lead, bgImage } = Astro.props;
---

<section class="page-hero">
  {bgImage && <div class="hero-bg" style={`background-image: url('${bgImage}')`} role="img" aria-hidden="true" />}
  <div class="hero-overlay"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="shell page-hero-content">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span class="current" aria-current="page">{kicker}</span>
    </nav>

    <div class="page-hero-text reveal">
      <p class="kicker kicker-pink">{kicker}</p>
      <h1>
        {title}
        {titleHighlight && <span> {titleHighlight}</span>}
      </h1>
      <p class="lead">{lead}</p>
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding-top: clamp(140px, 16vw, 190px);
    padding-bottom: clamp(60px, 8vw, 100px);
    overflow: hidden;
    color: white;
    background: var(--color-purple-black);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.28;
    filter: saturate(1.2);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(24, 5, 31, 0.75) 0%, rgba(24, 5, 31, 0.95) 85%, var(--color-purple-black) 100%),
      radial-gradient(ellipse at 80% 20%, rgba(240, 39, 197, 0.15), transparent 60%);
  }

  .hero-glow {
    position: absolute;
    top: -30%;
    right: -10%;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(112, 33, 179, 0.35) 0%, rgba(240, 39, 197, 0.15) 45%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }

  .page-hero-content {
    position: relative;
    z-index: 2;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: var(--color-pink-soft);
  }

  .breadcrumb .current {
    color: var(--color-pink-soft);
  }

  .page-hero h1 {
    max-width: 820px;
    margin-bottom: 22px;
    font-size: clamp(38px, 5.2vw, 68px);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .page-hero h1 span {
    color: var(--color-pink);
  }

  .page-hero .lead {
    max-width: 640px;
    margin-bottom: 0;
    color: rgba(255, 255, 255, 0.76);
    font-size: clamp(17px, 1.8vw, 21px);
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .page-hero {
      padding-top: 120px;
      padding-bottom: 48px;
    }
  }
</style>
