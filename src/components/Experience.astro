<section class="section-dark" id="experience">
  <div class="shell grid grid-cols-1 lg:grid-cols-[1.12fr_0.88fr] gap-11 lg:gap-24 items-center">
    <figure class="relative m-0 before:content-[''] before:absolute before:z-2 before:-top-3.5 before:-left-3.5 before:w-22.5 before:h-22.5 before:border-t-2 before:border-l-2 before:border-pink reveal">
      <img
