---
import { gallery } from '../data/content';
---

<section class="section-dark" id="gallery">
  <div class="shell">
    <div class="section-title-row reveal">
      <div>
        <p class="kicker kicker-pink">Along the way</p>
        <h2>Moments from<br /><span>the Camino.</span></h2>
      </div>
      <p class="text-white/60">Small moments, hard-won milestones and a community that lasts far beyond the trail.</p>
    </div>

    <div
      class="grid grid-cols-2 md:grid-cols-4 auto-rows-[180px] md:auto-rows-[220px] gap-2 md:gap-3 [&_.gallery-more]:hidden body-gallery-expanded:[&_.gallery-more]:block"
      data-gallery
    >
      {gallery.map((photo, index) => (
        <button
          class:list={[
            'relative overflow-hidden p-0 border-0 rounded-xl bg-[#32133d] cursor-zoom-in group reveal',
            { 'gallery-more': index >= 12 },
            // Spans on desktop vs mobile
            index === 0 || index === 7 ? 'max-md:[&:nth-child(3n+1)]:col-span-2 md:col-span-2' : 'max-md:[&:nth-child(3n+1)]:col-span-2',
            index === 4 ? 'row-span-2' : '',
          ]}
          type="button"
          data-index={index}
          data-type={photo.type || 'image'}
          data-full={photo.full}
          data-video-src={photo.videoSrc || ''}
          data-alt={photo.alt}
          aria-label={`Open ${photo.type === 'video' ? 'video' : 'photo'}: ${photo.alt}`}
        >
          <img
            src={photo.thumb}
            alt={photo.alt}
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-104 group-hover:opacity-85 transition-all duration-500 ease-out"
          />
          
          {photo.type === 'video' && (
            <div
              class="absolute top-3 left-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-white text-[11px] font-extrabold tracking-wider uppercase shadow-[0_4px_12px_rgba(0,0,0,0.3)] backdrop-blur-md"
              style="background: linear-gradient(135deg, #f027c5, #7021b3);"
              aria-hidden="true"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
              <span>Video</span>
            </div>
          )}

          {photo.type === 'gif' && (
            <div
              class="absolute top-3 left-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-white bg-[#18051f]/85 border border-white/20 text-[11px] font-extrabold tracking-wider uppercase shadow-[0_4px_12px_rgba(0,0,0,0.3)] backdrop-blur-md"
              aria-hidden="true"
            >
              <span>GIF</span>
            </div>
          )}

          <span
            class="absolute right-3 bottom-3 py-1.5 px-3 rounded-full text-white bg-[#18051f]/75 backdrop-blur-xs opacity-0 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 text-[11px] font-extrabold uppercase tracking-wider"
            aria-hidden="true"
          >
            {photo.type === 'video' ? 'Play Video' : 'View'}
          </span>
        </button>
      ))}
    </div>

    <div class="mt-9 flex justify-center items-center flex-wrap gap-4">
      <button class="button button-outline" type="button" data-gallery-toggle>
        Show more moments <span aria-hidden="true">+</span>
      </button>
      <a class="button button-primary" href="/gallery">
        Full gallery page <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<script>
  const galleryToggle = document.querySelector('[data-gallery-toggle]');
  galleryToggle?.addEventListener('click', () => {
    const isExpanded = document.body.classList.toggle('gallery-expanded');
    // Also toggle the more items display
    document.querySelectorAll('.gallery-more').forEach((el) => {
      if (el instanceof HTMLElement) {
        el.style.display = isExpanded ? 'block' : 'none';
      }
    });
    galleryToggle.innerHTML = isExpanded
      ? 'Show fewer photos <span aria-hidden="true">−</span>'
      : 'Show more moments <span aria-hidden="true">+</span>';
  });
</script>
