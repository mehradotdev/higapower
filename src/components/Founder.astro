<section class="section" id="founder">
  <div class="shell grid grid-cols-1 lg:grid-cols-[1fr_0.86fr] gap-12 lg:gap-24 items-center">
    <div class="reveal">
      <p class="kicker">Meet the founder</p>
      <h2>Ellie, the heart<br />behind <span>Higa Power.</span></h2>
      <p class="lead text-ink">
        “I started Higa Power to help women overcome the financial and personal barriers that stand between them and a transformative Camino.”
      </p>
      <p class="text-muted text-[17px] leading-[1.8]">
        I believe in the power of community, resilience and the magic of the Camino. Let’s make dreams come true together.
      </p>
      <div class="mt-9 font-display text-purple text-[31px] font-extrabold italic">
        Ellie <span class="block mt-1 text-muted font-sans text-xs not-italic uppercase tracking-[0.12em]">Founder, Higa Power</span>
      </div>
    </div>
    
    <div class="relative max-w-[660px] lg:max-w-none ml-auto w-full reveal">
      <img
        src="/assets/images/founder-ellie.jpg"
        alt="Ellie, founder of Higa Power"
        width="1036"
        height="1036"
        loading="lazy"
        class="w-full aspect-[0.9] object-cover rounded-[4px_4px_120px_4px]"
      />
      <div class="absolute -left-2.5 sm:-left-9 -bottom-7 sm:-bottom-9 p-3.5 rounded-full bg-cream">
        <img
          src="/assets/images/higa-power-logo.jpg"
          alt=""
          width="180"
          height="180"
          loading="lazy"
          class="w-19 h-19 sm:w-25 sm:h-25 rounded-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
