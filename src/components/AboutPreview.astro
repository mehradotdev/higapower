---
---

<section class="relative bg-cream section" id="mission">
  <div class="shell">
    <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-11 lg:gap-20 items-center">
      <div class="reveal">
        <p class="kicker">Our mission</p>
        <h2 class="mb-5">A historic path.<br /><span>A new beginning.</span></h2>
        <p class="lead">
          At Higa Power, we believe in the life-changing impact of the Camino de Santiago for women seeking courage, clarity, and renewal.
        </p>
        <p class="text-muted text-[17px] leading-[1.8] mt-4 mb-7">
          We sponsor deserving women to embark on this historic pilgrimage, providing full resources, logistics, and ongoing mentorship so each pilgrim can focus entirely on self-discovery and personal transformation.
        </p>

        <div class="flex flex-col gap-4 mb-8.5">
          <div class="flex items-center gap-4 p-3 sm:p-4 rounded-2xl bg-white/70 border border-line hover:bg-white hover:translate-x-1 transition-all duration-200">
            <span class="text-[22px] w-11 h-11 flex items-center justify-center rounded-xl bg-[#f3e7fa] shrink-0" aria-hidden="true">🥾</span>
            <div class="flex flex-col gap-0.5">
              <strong class="font-display text-base font-bold text-ink">Inward Journey</strong>
              <span class="text-sm text-muted leading-tight">800+ km of reflection & resilience</span>
            </div>
          </div>
          <div class="flex items-center gap-4 p-3 sm:p-4 rounded-2xl bg-white/70 border border-line hover:bg-white hover:translate-x-1 transition-all duration-200">
            <span class="text-[22px] w-11 h-11 flex items-center justify-center rounded-xl bg-[#f3e7fa] shrink-0" aria-hidden="true">💫</span>
            <div class="flex flex-col gap-0.5">
              <strong class="font-display text-base font-bold text-ink">Full Sponsorship</strong>
              <span class="text-sm text-muted leading-tight">Accommodations and logistics covered</span>
            </div>
          </div>
          <div class="flex items-center gap-4 p-3 sm:p-4 rounded-2xl bg-white/70 border border-line hover:bg-white hover:translate-x-1 transition-all duration-200">
            <span class="text-[22px] w-11 h-11 flex items-center justify-center rounded-xl bg-[#f3e7fa] shrink-0" aria-hidden="true">👭</span>
            <div class="flex flex-col gap-0.5">
              <strong class="font-display text-base font-bold text-ink">Sisterhood & Care</strong>
              <span class="text-sm text-muted leading-tight">Guided mentorship from founder Ellie</span>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap gap-4">
          <a class="button button-dark" href="/about">
            Our story & founder <span aria-hidden="true">→</span>
          </a>
          <a class="button button-outline-dark" href="/journey">
            How sponsorship works <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="relative max-w-[560px] lg:max-w-none reveal">
        <div class="relative block before:content-[''] before:absolute before:z-2 before:-top-3.5 before:-left-3.5 before:w-20 before:h-20 before:border-t-3 before:border-l-3 before:border-pink before:rounded-tl-xs">
          <img
            src="/assets/images/camino-gateway.jpg"
            alt="The gateway on the Camino Francés"
            width="1200"
            height="1600"
            loading="lazy"
            class="w-full max-h-[440px] sm:max-h-[590px] object-cover rounded-[4px_60px_4px_4px] sm:rounded-[4px_90px_4px_4px] shadow-[0_24px_60px_rgba(42,9,63,0.14)] block"
          />
          <div class="absolute bottom-3.5 sm:bottom-5.5 left-3.5 sm:left-5.5 py-2 sm:py-2.5 px-3.5 sm:px-4.5 rounded-full text-white bg-[#18051f]/82 backdrop-blur-md text-xs sm:text-[13px] font-semibold tracking-wide flex items-center gap-2.5 shadow-[0_8px_30px_rgba(0,0,0,0.3)] z-3">
            <span class="w-2 h-2 rounded-full bg-pink shadow-[0_0_10px_#f027c5] shrink-0" aria-hidden="true"></span>
            <span>The gateway on the Camino Francés</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
