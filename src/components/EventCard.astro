---
import type { EventItem } from '../data/types';

interface Props {
  event: EventItem;
}

const { event } = Astro.props;
---

<article class="overflow-hidden border border-line rounded-[26px] bg-white block md:grid md:grid-cols-[0.9fr_1.1fr] lg:block reveal">
  <img
    src={event.image}
    alt={event.title}
    width="720"
    height="405"
    loading="lazy"
    class:list={[
      'w-full object-cover h-[250px] md:h-full md:min-h-[350px] lg:min-h-0',
      event.isFeatured ? 'lg:h-[390px]' : 'lg:h-[310px]',
    ]}
  />
  <div class="p-6 sm:p-7">
    <div class="flex flex-wrap gap-2 mb-5">
      <span class="px-2.5 py-1.5 rounded-full text-purple bg-[#f3e7fa] text-[11px] font-extrabold uppercase tracking-wider">
        {event.date}
      </span>
      <span class="px-2.5 py-1.5 rounded-full text-purple bg-[#f3e7fa] text-[11px] font-extrabold uppercase tracking-wider">
        {event.location}
      </span>
      <span class="px-2.5 py-1.5 rounded-full text-[#176c43] bg-[#e4f8ee] text-[11px] font-extrabold uppercase tracking-wider">
        {event.status}
      </span>
    </div>
    <h3 class="font-display font-bold mb-3.5 text-[27px] leading-tight tracking-[-0.035em] text-ink">
      {event.title}
    </h3>
    <p class="text-muted leading-[1.7] mb-4">
      {event.description}
    </p>
    {event.link && (
      <a class="text-link" href={event.link} target="_blank" rel="noreferrer">
        Visit the fundraiser <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</article>
