---
import type { EventItem } from '../data/types';

interface Props {
  event: EventItem;
}

const { event } = Astro.props;
---

<article class:list={['event-card', 'reveal', { 'event-main': event.isFeatured }]}>
  <img src={event.image} alt={event.title} width="720" height="405" loading="lazy" />
  <div class="event-body">
    <div class="event-meta">
      <span>{event.date}</span>
      <span>{event.location}</span>
      <span class="status">{event.status}</span>
    </div>
    <h3>{event.title}</h3>
    <p>{event.description}</p>
    {event.link && (
      <a class="text-link" href={event.link} target="_blank" rel="noreferrer">
        Visit the fundraiser <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</article>

<style>
  .event-card {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 26px;
    background: white;
  }

  .event-card > img {
    width: 100%;
    height: 310px;
    object-fit: cover;
  }

  .event-main > img {
    height: 390px;
  }

  .event-body {
    padding: 28px;
  }

  .event-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .event-meta span {
    padding: 7px 10px;
    border-radius: 999px;
    color: var(--color-purple);
    background: #f3e7fa;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .event-meta .status {
    color: #176c43;
    background: #e4f8ee;
  }

  .event-card h3 {
    margin-bottom: 13px;
    font-size: 27px;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .event-card p {
    color: var(--color-muted);
    line-height: 1.7;
  }

  @media (max-width: 960px) {
    .event-card,
    .event-main {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
    }

    .event-card > img,
    .event-main > img {
      height: 100%;
      min-height: 350px;
    }
  }

  @media (max-width: 760px) {
    .event-card,
    .event-main {
      display: block;
    }

    .event-card > img,
    .event-main > img {
      min-height: 0;
      height: 250px;
    }
  }
</style>
