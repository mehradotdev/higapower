<section class="relative min-h-[660px] sm:min-h-[690px] grid items-center overflow-hidden text-white" id="support">
  <div
    class="absolute inset-0 bg-cover bg-no-repeat bg-[center_48%]"
    style="background-image: url('/assets/images/camino-frances.jpg')"
    role="img"
    aria-label="Two pilgrims walking across the countryside"
  ></div>
  <div
    class="absolute inset-0"
    style="background: linear-gradient(90deg, rgba(26, 4, 35, 0.92), rgba(50, 10, 71, 0.72) 52%, rgba(35, 6, 49, 0.1));"
  ></div>
  
  <div class="shell relative z-2 reveal">
    <p class="kicker kicker-pink">Make a difference</p>
    <h2 class="max-w-[850px]">Help another woman<br />take her <span>first step.</span></h2>
    <p class="max-w-[650px] mb-8 text-white/75 text-[18px] leading-[1.75]">
      Higa Power depends on private donations and community fundraising to make these transformative journeys accessible to women who need them most.
    </p>
    <a class="button button-primary" href="/events">
      Support the next journey <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
