---
import { events } from '../data/content';
import EventCard from './EventCard.astro';
---

<section class="section" id="events">
  <div class="shell">
    <div class="section-title-row reveal">
      <div>
        <p class="kicker">Miles already walked</p>
        <h2>Challenges with<br /><span>real impact.</span></h2>
      </div>
      <p>Community, courage and a shared destination turn every challenge into meaningful support.</p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-[1.25fr_0.75fr] gap-6">
      {events.map((event) => (
        <EventCard event={event} />
      ))}
    </div>

    <div class="mt-9 flex justify-start lg:justify-end reveal">
      <a class="text-link inline-flex" href="/events">
        View all challenges and impact <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
