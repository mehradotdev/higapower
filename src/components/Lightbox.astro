---
---

<dialog class="lightbox" data-lightbox aria-label="Media lightbox">
  <button type="button" class="lightbox-close" aria-label="Close media" data-lightbox-close>×</button>
  <button type="button" class="lightbox-nav lightbox-prev" aria-label="Previous item" data-lightbox-prev>‹</button>
  <button type="button" class="lightbox-nav lightbox-next" aria-label="Next item" data-lightbox-next>›</button>
  
  <div class="lightbox-content">
    <img src="" alt="" data-lightbox-image class="lightbox-media" />
    <video
      data-lightbox-video
      class="lightbox-media lightbox-video"
      controls
      playsinline
      preload="metadata"
    ></video>
    <p data-lightbox-caption></p>
  </div>
</dialog>

<style>
  .lightbox {
    width: min(92vw, 1100px);
    max-height: 92vh;
    padding: 0;
    border: 0;
    border-radius: 16px;
    color: white;
    background: #110416;
    box-shadow: 0 24px 100px rgba(0, 0, 0, 0.5);
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: rgba(10, 2, 14, 0.88);
    backdrop-filter: blur(8px);
  }

  .lightbox-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 12px;
  }

  .lightbox-media {
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: 8px;
  }

  .lightbox-video {
    display: none;
    background: black;
  }

  .lightbox p {
    margin: 0;
    padding: 14px 20px 6px;
    text-align: center;
    color: rgba(255, 255, 255, 0.85);
    font-size: 15px;
  }

  .lightbox-close {
    position: fixed;
    z-index: 10;
    top: 22px;
    right: 22px;
    width: 45px;
    height: 45px;
    border: 0;
    border-radius: 50%;
    color: white;
    background: rgba(10, 2, 14, 0.7);
    font-size: 29px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, transform 0.2s;
  }

  .lightbox-close:hover {
    background: var(--color-pink);
    transform: scale(1.05);
  }

  .lightbox-nav {
    position: fixed;
    z-index: 10;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    color: white;
    background: rgba(10, 2, 14, 0.7);
    font-size: 36px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, transform 0.2s;
    user-select: none;
  }

  .lightbox-prev {
    left: 22px;
  }

  .lightbox-next {
    right: 22px;
  }

  .lightbox-nav:hover {
    background: var(--color-pink);
    transform: translateY(-50%) scale(1.05);
  }

  @media (max-width: 760px) {
    .lightbox-nav {
      width: 40px;
      height: 40px;
      font-size: 28px;
    }
    .lightbox-prev {
      left: 10px;
    }
    .lightbox-next {
      right: 10px;
    }
  }
</style>

<script>
  const lightbox = document.querySelector('[data-lightbox]');
  const lightboxImage = document.querySelector('[data-lightbox-image]');
  const lightboxVideo = document.querySelector('[data-lightbox-video]');
  const lightboxCaption = document.querySelector('[data-lightbox-caption]');
  const closeBtn = document.querySelector('[data-lightbox-close]');
  const prevBtn = document.querySelector('[data-lightbox-prev]');
  const nextBtn = document.querySelector('[data-lightbox-next]');

  let currentIndex = 0;
  const getGalleryButtons = () => Array.from(document.querySelectorAll('[data-gallery] [data-full]'));

  const stopVideo = () => {
    if (lightboxVideo instanceof HTMLVideoElement) {
      lightboxVideo.pause();
      lightboxVideo.removeAttribute('src');
      lightboxVideo.load();
      lightboxVideo.style.display = 'none';
    }
  };

  const showMediaAtIndex = (index: number) => {
    const buttons = getGalleryButtons();
    if (!buttons.length) return;
    if (index < 0) index = buttons.length - 1;
    if (index >= buttons.length) index = 0;
    currentIndex = index;

    const button = buttons[currentIndex];
    if (!button) return;

    const mediaType = button.getAttribute('data-type') || 'image';
    const fullSrc = button.getAttribute('data-full') || '';
    const videoSrc = button.getAttribute('data-video-src') || '';
    const altText = button.getAttribute('data-alt') || '';

    if (lightboxCaption) lightboxCaption.textContent = altText;

    if (mediaType === 'video' && videoSrc && lightboxVideo instanceof HTMLVideoElement) {
      if (lightboxImage instanceof HTMLImageElement) lightboxImage.style.display = 'none';
      lightboxVideo.style.display = 'block';
      lightboxVideo.src = videoSrc;
      lightboxVideo.play().catch(() => {});
    } else {
      stopVideo();
      if (lightboxImage instanceof HTMLImageElement) {
        lightboxImage.style.display = 'block';
        lightboxImage.src = fullSrc;
        lightboxImage.alt = altText;
      }
    }
  };

  const closeLightbox = () => {
    stopVideo();
    if (lightbox instanceof HTMLDialogElement) lightbox.close();
  };

  document.querySelectorAll('[data-gallery] [data-full]').forEach((button, index) => {
    button.addEventListener('click', () => {
      if (!(lightbox instanceof HTMLDialogElement)) return;
      showMediaAtIndex(index);
      lightbox.showModal();
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);

  prevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    showMediaAtIndex(currentIndex - 1);
  });

  nextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    showMediaAtIndex(currentIndex + 1);
  });

  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) {
      closeLightbox();
    }
  });

  lightbox?.addEventListener('close', stopVideo);

  window.addEventListener('keydown', (event) => {
    if (!(lightbox instanceof HTMLDialogElement) || !lightbox.open) return;
    if (event.key === 'ArrowLeft') {
      showMediaAtIndex(currentIndex - 1);
    } else if (event.key === 'ArrowRight') {
      showMediaAtIndex(currentIndex + 1);
    } else if (event.key === 'Escape') {
      closeLightbox();
    }
  });
</script>
