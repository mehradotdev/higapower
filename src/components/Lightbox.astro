---
---

<dialog
  class="fixed inset-0 m-0 p-0 w-screen h-screen max-w-none max-h-none border-0 bg-transparent text-white overflow-hidden"
  data-lightbox
  aria-label="Media lightbox"
>
  <!-- Close Button -->
  <button
    type="button"
    class="fixed z-30 top-4 right-4 sm:top-6 sm:right-6 w-11 h-11 border border-white/20 rounded-full text-white bg-[#18051f]/80 backdrop-blur-md text-2xl cursor-pointer flex items-center justify-center hover:bg-pink hover:border-pink hover:scale-105 transition-all duration-200 shadow-[0_4px_20px_rgba(0,0,0,0.5)]"
    aria-label="Close media"
    data-lightbox-close
  >
    ×
  </button>
  
  <!-- Prev Button -->
  <button
    type="button"
    class="fixed z-30 top-1/2 -translate-y-1/2 left-3 sm:left-6 w-11 sm:w-13 h-11 sm:h-13 border border-white/20 rounded-full text-white bg-[#18051f]/80 backdrop-blur-md text-2xl sm:text-4xl leading-none cursor-pointer flex items-center justify-center hover:bg-pink hover:border-pink hover:scale-105 transition-all duration-200 select-none shadow-[0_4px_20px_rgba(0,0,0,0.5)]"
    aria-label="Previous item"
    data-lightbox-prev
  >
    ‹
  </button>
  
  <!-- Next Button -->
  <button
    type="button"
    class="fixed z-30 top-1/2 -translate-y-1/2 right-3 sm:right-6 w-11 sm:w-13 h-11 sm:h-13 border border-white/20 rounded-full text-white bg-[#18051f]/80 backdrop-blur-md text-2xl sm:text-4xl leading-none cursor-pointer flex items-center justify-center hover:bg-pink hover:border-pink hover:scale-105 transition-all duration-200 select-none shadow-[0_4px_20px_rgba(0,0,0,0.5)]"
    aria-label="Next item"
    data-lightbox-next
  >
    ›
  </button>
  
  <!-- Backdrop & Centered Media Stage -->
  <div class="w-full h-full flex flex-col items-center justify-center p-4 sm:p-8 cursor-zoom-out" data-lightbox-backdrop>
    <div class="relative flex flex-col items-center justify-center max-w-[min(92vw,1150px)] max-h-[88dvh] cursor-default" data-lightbox-inner>
      <div class="relative flex items-center justify-center rounded-2xl overflow-hidden bg-[#18051f]/60 border border-white/10 shadow-[0_24px_80px_rgba(0,0,0,0.7)]">
        <img
          src=""
          alt=""
          data-lightbox-image
          class="max-w-[min(88vw,1100px)] max-h-[min(76dvh,800px)] w-auto h-auto object-contain rounded-2xl transition-opacity duration-200"
        />
        <video
          data-lightbox-video
          class="max-w-[min(88vw,1100px)] max-h-[min(76dvh,800px)] w-auto h-auto object-contain rounded-2xl hidden bg-black"
          controls
          playsinline
          preload="metadata"
        ></video>
      </div>
      <p
        class="mt-3.5 px-5 py-2 rounded-full bg-[#18051f]/85 backdrop-blur-md border border-white/12 text-center text-white/90 text-sm md:text-[15px] font-medium tracking-wide shadow-lg max-w-[85vw] truncate"
        data-lightbox-caption
      ></p>
    </div>
  </div>
</dialog>

<style>
  dialog[data-lightbox] {
    position: fixed;
    inset: 0;
    margin: 0;
    padding: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: 100vw;
    max-height: 100dvh;
    border: none;
    background: transparent;
    display: none;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    z-index: 9999;
  }

  dialog[data-lightbox][open] {
    display: flex;
  }

  dialog[data-lightbox]::backdrop {
    background: rgba(9, 2, 13, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
</style>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const lightboxImage = document.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const lightboxVideo = document.querySelector<HTMLVideoElement>('[data-lightbox-video]');
  const lightboxCaption = document.querySelector<HTMLElement>('[data-lightbox-caption]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-close]');
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-next]');

  let currentIndex = 0;
  const getGalleryButtons = () => Array.from(document.querySelectorAll('[data-gallery] [data-full]'));

  const stopVideo = () => {
    if (lightboxVideo instanceof HTMLVideoElement) {
      lightboxVideo.pause();
      lightboxVideo.removeAttribute('src');
      lightboxVideo.load();
      lightboxVideo.style.display = 'none';
    }
  };

  const showMediaAtIndex = (index: number) => {
    const buttons = getGalleryButtons();
    if (!buttons.length) return;
    if (index < 0) index = buttons.length - 1;
    if (index >= buttons.length) index = 0;
    currentIndex = index;

    const button = buttons[currentIndex];
    if (!button) return;

    const mediaType = button.getAttribute('data-type') || 'image';
    const fullSrc = button.getAttribute('data-full') || '';
    const videoSrc = button.getAttribute('data-video-src') || '';
    const altText = button.getAttribute('data-alt') || '';

    if (lightboxCaption) {
      if (altText) {
        lightboxCaption.textContent = altText;
        lightboxCaption.style.display = 'block';
      } else {
        lightboxCaption.style.display = 'none';
      }
    }

    if (mediaType === 'video' && videoSrc && lightboxVideo instanceof HTMLVideoElement) {
      if (lightboxImage instanceof HTMLImageElement) lightboxImage.style.display = 'none';
      lightboxVideo.style.display = 'block';
      lightboxVideo.src = videoSrc;
      lightboxVideo.play().catch(() => {});
    } else {
      stopVideo();
      if (lightboxImage instanceof HTMLImageElement) {
        lightboxImage.style.display = 'block';
        lightboxImage.src = fullSrc;
        lightboxImage.alt = altText;
      }
    }
  };

  const closeLightbox = () => {
    stopVideo();
    if (lightbox instanceof HTMLDialogElement) lightbox.close();
  };

  document.querySelectorAll('[data-gallery] [data-full]').forEach((button, index) => {
    button.addEventListener('click', () => {
      if (!(lightbox instanceof HTMLDialogElement)) return;
      showMediaAtIndex(index);
      lightbox.showModal();
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);

  prevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    showMediaAtIndex(currentIndex - 1);
  });

  nextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    showMediaAtIndex(currentIndex + 1);
  });

  lightbox?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target === lightbox || target.hasAttribute('data-lightbox-backdrop')) {
      closeLightbox();
    }
  });

  lightbox?.addEventListener('close', stopVideo);

  // Keyboard navigation
  window.addEventListener('keydown', (event) => {
    if (!(lightbox instanceof HTMLDialogElement) || !lightbox.open) return;
    if (event.key === 'ArrowLeft') {
      showMediaAtIndex(currentIndex - 1);
    } else if (event.key === 'ArrowRight') {
      showMediaAtIndex(currentIndex + 1);
    } else if (event.key === 'Escape') {
      closeLightbox();
    }
  });

  // Touch swipe support
  let touchStartX = 0;
  let touchStartY = 0;

  lightbox?.addEventListener('touchstart', (e: TouchEvent) => {
    if (!e.changedTouches[0]) return;
    touchStartX = e.changedTouches[0].clientX;
    touchStartY = e.changedTouches[0].clientY;
  }, { passive: true });

  lightbox?.addEventListener('touchend', (e: TouchEvent) => {
    if (!e.changedTouches[0]) return;
    const touchEndX = e.changedTouches[0].clientX;
    const touchEndY = e.changedTouches[0].clientY;
    const dx = touchEndX - touchStartX;
    const dy = touchEndY - touchStartY;
    
    if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.5) {
      if (dx < 0) {
        showMediaAtIndex(currentIndex + 1);
      } else {
        showMediaAtIndex(currentIndex - 1);
      }
    }
  }, { passive: true });
</script>
