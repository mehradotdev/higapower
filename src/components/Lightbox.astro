---
---

<dialog
  class="w-[min(92vw,1100px)] max-h-[92vh] p-0 border-0 rounded-2xl text-white bg-[#110416] shadow-[0_24px_100px_rgba(0,0,0,0.5)] overflow-hidden backdrop:bg-[#0a020e]/88 backdrop:backdrop-blur-md"
  data-lightbox
  aria-label="Media lightbox"
>
  <button
    type="button"
    class="fixed z-10 top-5.5 right-5.5 w-11 h-11 border-0 rounded-full text-white bg-[#0a020e]/70 text-2xl sm:text-3xl cursor-pointer flex items-center justify-center hover:bg-pink hover:scale-105 transition-all duration-200"
    aria-label="Close media"
    data-lightbox-close
  >
    ×
  </button>
  <button
    type="button"
    class="fixed z-10 top-1/2 -translate-y-1/2 left-2.5 sm:left-5.5 w-10 sm:w-12 h-10 sm:h-12 border-0 rounded-full text-white bg-[#0a020e]/70 text-2xl sm:text-4xl leading-none cursor-pointer flex items-center justify-center hover:bg-pink hover:scale-105 transition-all duration-200 select-none"
    aria-label="Previous item"
    data-lightbox-prev
  >
    ‹
  </button>
  <button
    type="button"
    class="fixed z-10 top-1/2 -translate-y-1/2 right-2.5 sm:right-5.5 w-10 sm:w-12 h-10 sm:h-12 border-0 rounded-full text-white bg-[#0a020e]/70 text-2xl sm:text-4xl leading-none cursor-pointer flex items-center justify-center hover:bg-pink hover:scale-105 transition-all duration-200 select-none"
    aria-label="Next item"
    data-lightbox-next
  >
    ›
  </button>
  
  <div class="flex flex-col items-center justify-center p-3">
    <img src="" alt="" data-lightbox-image class="w-full max-h-[78vh] object-contain rounded-lg" />
    <video
      data-lightbox-video
      class="w-full max-h-[78vh] object-contain rounded-lg hidden bg-black"
      controls
      playsinline
      preload="metadata"
    ></video>
    <p class="m-0 pt-3.5 px-5 pb-1.5 text-center text-white/85 text-[15px]" data-lightbox-caption></p>
  </div>
</dialog>

<script>
  const lightbox = document.querySelector('[data-lightbox]');
  const lightboxImage = document.querySelector('[data-lightbox-image]');
  const lightboxVideo = document.querySelector('[data-lightbox-video]');
  const lightboxCaption = document.querySelector('[data-lightbox-caption]');
  const closeBtn = document.querySelector('[data-lightbox-close]');
  const prevBtn = document.querySelector('[data-lightbox-prev]');
  const nextBtn = document.querySelector('[data-lightbox-next]');

  let currentIndex = 0;
  const getGalleryButtons = () => Array.from(document.querySelectorAll('[data-gallery] [data-full]'));

  const stopVideo = () => {
    if (lightboxVideo instanceof HTMLVideoElement) {
      lightboxVideo.pause();
      lightboxVideo.removeAttribute('src');
      lightboxVideo.load();
      lightboxVideo.style.display = 'none';
    }
  };

  const showMediaAtIndex = (index: number) => {
    const buttons = getGalleryButtons();
    if (!buttons.length) return;
    if (index < 0) index = buttons.length - 1;
    if (index >= buttons.length) index = 0;
    currentIndex = index;

    const button = buttons[currentIndex];
    if (!button) return;

    const mediaType = button.getAttribute('data-type') || 'image';
    const fullSrc = button.getAttribute('data-full') || '';
    const videoSrc = button.getAttribute('data-video-src') || '';
    const altText = button.getAttribute('data-alt') || '';

    if (lightboxCaption) lightboxCaption.textContent = altText;

    if (mediaType === 'video' && videoSrc && lightboxVideo instanceof HTMLVideoElement) {
      if (lightboxImage instanceof HTMLImageElement) lightboxImage.style.display = 'none';
      lightboxVideo.style.display = 'block';
      lightboxVideo.src = videoSrc;
      lightboxVideo.play().catch(() => {});
    } else {
      stopVideo();
      if (lightboxImage instanceof HTMLImageElement) {
        lightboxImage.style.display = 'block';
        lightboxImage.src = fullSrc;
        lightboxImage.alt = altText;
      }
    }
  };

  const closeLightbox = () => {
    stopVideo();
    if (lightbox instanceof HTMLDialogElement) lightbox.close();
  };

  document.querySelectorAll('[data-gallery] [data-full]').forEach((button, index) => {
    button.addEventListener('click', () => {
      if (!(lightbox instanceof HTMLDialogElement)) return;
      showMediaAtIndex(index);
      lightbox.showModal();
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);

  prevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    showMediaAtIndex(currentIndex - 1);
  });

  nextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    showMediaAtIndex(currentIndex + 1);
  });

  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) {
      closeLightbox();
    }
  });

  lightbox?.addEventListener('close', stopVideo);

  window.addEventListener('keydown', (event) => {
    if (!(lightbox instanceof HTMLDialogElement) || !lightbox.open) return;
    if (event.key === 'ArrowLeft') {
      showMediaAtIndex(currentIndex - 1);
    } else if (event.key === 'ArrowRight') {
      showMediaAtIndex(currentIndex + 1);
    } else if (event.key === 'Escape') {
      closeLightbox();
    }
  });
</script>
